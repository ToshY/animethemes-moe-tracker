{"id":3497,"name":"Akihabara Dennou-gumi","slug":"akihabara_dennou_gumi","synopsis":"A \"patapi\" is a cute mechanical creature which is like a cyber pet. It can eat, sleep, play, and even help out its owners with some stuff. When Hibari Hanakoganei receives a patapi from a prince in her dreams, she is thrilled and names it \"Densuke\". When mysterious forces try to steal Densuke, Hibari discovers that Densuke is not just an ordinary patapi. Densuke has magical powers that allows it to transform into a powerful cyber-fighter who looks like Hibari. Hibari's friends also receive similar patapis, and together they form the Cyber Team in Akihabara.\n\n(Source: AnimeNfo)","format":"TV","season":"SPRING","year":1998,"createdAt":"2021-09-22 08:08:54","updatedAt":"2021-09-23 03:57:17","resources":{"nodes":[{"site":"MAL","externalId":2288},{"site":"ANILIST","externalId":2288},{"site":"ANIDB","externalId":509},{"site":"KITSU","externalId":2073},{"site":"ANN","externalId":1072},{"site":"ANIME_PLANET","externalId":2526}]},"images":{"nodes":[{"id":7926,"facet":"LARGE_COVER","path":"anime/large-cover/VEjUYvWZwWwrNFrC621vMui3YdghckPuTnJZXuRl.png"},{"id":7927,"facet":"SMALL_COVER","path":"anime/small-cover/okmh0f0Ks2ocfNohdObCk4ynUVUSZIXPfIbxJeDf.avif"}]},"studios":{"nodes":[{"id":104,"name":"Production Reed","slug":"production_reed"}]},"series":{"nodes":[]},"animethemes":[{"id":10685,"slug":"OP1","type":"OP","sequence":null,"song":{"id":10694,"title":"Birth","titleNative":null},"animethemeentries":[{"id":12476,"version":1,"episodes":"1-25","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":14423,"basename":"AkihabaraDennougumi-OP1.webm","filename":"AkihabaraDennougumi-OP1","link":"https://v.animethemes.moe/AkihabaraDennougumi-OP1.webm","mimetype":"video/webm","size":52358131,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":10727,"basename":"AkihabaraDennougumi-OP1.ogg","filename":"AkihabaraDennougumi-OP1","