{"id":565,"name":"Danshi Koukousei no Nichijou","slug":"danshi_koukousei_no_nichijou","synopsis":"Tadakuni, Hidenori, and Yoshitake are students at the all-boys academy, Sanada North High School. This is a tale about just that—their daily lives as students. Winning the basketball tournament? Finding true love? You won't find any of that here. Whether it's sparking random arguments while hanging out with friends, meeting that one weird co-worker at a part-time job, or even letting imaginations run wild on a windy afternoon, we've all experienced the show's ordinary but true-to-life themes at one point or another. \n\n\r\n(Source: NIS America) ","format":"TV","season":"WINTER","year":2012,"createdAt":"2021-03-27 00:43:39","updatedAt":"2021-03-28 01:20:51","resources":{"nodes":[{"site":"MAL","externalId":11843},{"site":"ANILIST","externalId":11843},{"site":"KITSU","externalId":6616},{"site":"ANIDB","externalId":8729},{"site":"ANN","externalId":13743},{"site":"ANIME_PLANET","externalId":4564},{"site":"OFFICIAL_SITE","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":1125,"facet":"LARGE_COVER","path":"anime/large-cover/JLYEKlXK3w0Awk51M8u7p7MNsjzfUMjLvRKbq9KT.jpg"},{"id":1126,"facet":"SMALL_COVER","path":"anime/small-cover/KmsqtpMTyciKH018TC6PWQIrui6vJJo4m7lpS2Et.avif"}]},"studios":{"nodes":[{"id":25,"name":"Sunrise","slug":"sunrise"}]},"series":{"nodes":[]},"animethemes":[{"id":4829,"slug":"OP1","type":"OP","sequence":null,"song":{"id":4829,"title":"Shiny tale","titleNative":null},"animethemeentries":[{"id":5516,"version":1,"episodes":"1-11","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":4361,"basename":"DanshiKoukouseiNoNichijou-OP1.webm","filename":"DanshiKoukouseiNoNichijou-OP1","link":"https://v.animethemes.moe/DanshiKoukouseiNoNichijou-OP1.webm","mimetype":"video/webm","size":29777412,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":3975,"basename":"Da