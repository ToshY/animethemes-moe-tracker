{"id":270,"name":"Bernard-jou Iwaku.","slug":"bernard_jou_iwaku","synopsis":"The short gag manga is about the love of famous works of literature. It follows Sawako \"Miss Bernard\" Machida, a lazy girl who wants to be a well-read person — but does not actually read much. The manga recounts the conversations between \"Miss Bernard\" and her bookworm friends about the Bible, The Tale of the Heike, Guns, Germs, and Steel, The Door into Summer, The Great Passage, Fermat's Last Theorem, and more masterpieces that she has not necessarily read.\n\n\n(Source: Anime News Network)","format":"TV_SHORT","season":"FALL","year":2016,"createdAt":"2021-03-27 00:43:32","updatedAt":"2021-03-28 00:29:03","resources":{"nodes":[{"site":"MAL","externalId":33462},{"site":"ANILIST","externalId":21854},{"site":"KITSU","externalId":12556},{"site":"ANIDB","externalId":12226},{"site":"ANN","externalId":18697},{"site":"ANIME_PLANET","externalId":7961},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":539,"facet":"LARGE_COVER","path":"anime/large-cover/pVSJDEEMEv6Ic3st5WkvTGXP9gVDDwV58AtINpr2.jpg"},{"id":540,"facet":"SMALL_COVER","path":"anime/small-cover/YGKCUs1BRZ82qg0xykp0bwHcrlYTYBBRCQywlMyS.avif"}]},"studios":{"nodes":[{"id":98,"name":"Creators in Pack","slug":"creators_in_pack"}]},"series":{"nodes":[]},"animethemes":[{"id":6564,"slug":"ED1","type":"ED","sequence":null,"song":{"id":6564,"title":"Love! Library","titleNative":null},"animethemeentries":[{"id":7638,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":6581,"basename":"BernardJouIwaku-ED1.webm","filename":"BernardJouIwaku-ED1","link":"https://v.animethemes.moe/BernardJouIwaku-ED1.webm","mimetype":"video/webm","size":8936645,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags":"","audio":{"id":5722,"basename":"BernardJouIwaku-ED1.ogg","filename":"BernardJouIwaku-ED1","