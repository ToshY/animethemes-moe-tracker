{"id":1250,"title":{"romaji":"Ima, Soko ni Iru Boku","english":"Now and Then, Here and There","native":"今、そこにいる僕"},"slug":"ima_soko_ni_iru_boku","synopsis":"Shu is a typical Japanese boy, but has an unbeatable, optimistic and determined attitude. However, when he sees a mysterious girl with strange eyes named Lala-Ru up on a smokestack, he is soon pulled into a strange desert world. Shu soon discovers the true terrors of war, which includes genocide, brutal torture, hunger, thirst, and child exploitation. Now Shu is trying to save Lala-Ru, as well as his hard earned, and often relunctant, new friends from the insane dictator, Hamdo. Whether Shu can possibly accomplish saving those he cares about while still holding up to his values remains to be seen. \n\n(Source: Anime News Network) ","format":"TV","season":"FALL","year":1999,"createdAt":"2021-03-27 00:43:57","updatedAt":"2021-03-28 03:25:16","resources":{"nodes":[{"site":"MAL","externalId":160},{"site":"ANILIST","externalId":160},{"site":"KITSU","externalId":138},{"site":"ANIDB","externalId":114},{"site":"ANN","externalId":287},{"site":"ANIME_PLANET","externalId":12}]},"images":{"nodes":[{"id":2491,"facet":"LARGE_COVER","path":"anime/large-cover/w51UenxGRjS3vpv66arhXesiD13H3tUnmW4U4vsE.jpg"},{"id":2492,"facet":"SMALL_COVER","path":"anime/small-cover/TdAwlqW5RA9FGkbVpheHrVKdudaM5IDH2X7bioKb.avif"}]},"studios":{"nodes":[{"id":20,"name":"AIC","slug":"aic"}]},"series":{"nodes":[]},"animethemes":[{"id":763,"slug":"OP1","type":"OP","sequence":null,"song":{"id":763,"title":{"romaji":"Ima, Soko ni Iru Boku","native":null}},"animethemeentries":[{"id":835,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":13129,"basename":"ImaSokoNiIruBoku-OP1.webm","filename":"ImaSokoNiIruBoku-OP1","link":"https://v.animethemes.moe/ImaSokoNiIruBoku-OP1.webm","mimetype":"video/webm","size":5144642,"resolution":576,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"DVD","tags":"DVD576","audio":