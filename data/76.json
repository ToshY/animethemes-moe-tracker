{"id":76,"title":{"romaji":"Akagami no Shirayuki-hime","english":"Snow White with the Red Hair","native":"赤髪の白雪姫"},"slug":"akagami_no_shirayuki_hime","synopsis":"In the kingdom of Tanbarun lives Shirayuki, an independent and strong-willed young woman. Her resourceful intelligence has led her become a skilled pharmacist, but her most defining trait is her shock of beautiful apple-red hair. Her dazzling mane gets her noticed by the prince of the kingdom, but instead of romancing her, he demands she be his concubine. Shirayuki refuses, chops off her lovely locks, and runs away to the neighboring kingdom of Clarines. There, she befriends a young man named Zen, who, SURPRISE, is also a prince, although with a much better temperament than the previous one. Watch as Shirayuki finds her place in the new kingdom, and in Zen’s heart.\n\n(Source: FUNimation)","format":"TV","season":"SUMMER","year":2015,"createdAt":"2021-03-27 00:43:27","updatedAt":"2021-03-27 23:54:38","resources":{"nodes":[{"site":"MAL","externalId":30123},{"site":"ANILIST","externalId":21058},{"site":"KITSU","externalId":10621},{"site":"ANIDB","externalId":11082},{"site":"ANN","externalId":16792},{"site":"ANIME_PLANET","externalId":7018},{"site":"OFFICIAL_SITE","externalId":null},{"site":"HULU","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":151,"facet":"LARGE_COVER","path":"anime/large-cover/ASeRUi2GHJukMAtm764JRrljTlrjJbaMYtbHUfes.jpg"},{"id":152,"facet":"SMALL_COVER","path":"anime/small-cover/CghHjuRQuoel05OciHRTcs2RBWTStzMEa6LKTtyA.avif"}]},"studios":{"nodes":[{"id":17,"name":"Bones","slug":"bones"}]},"series":{"nodes":[{"id":525,"name":"Akagami no Shirayuki-hime","slug":"akagami_no_shirayuki_hime"}]},"animethemes":[{"id":6158,"slug":"OP1","type":"OP","sequence":null,"song":{"id":6158,"title":{"romaji":"Yasashii Kibou","native":null}},"animethemeentries":[{"id":7117,"version":1,"episodes":"1-12","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":6253,"basename":"