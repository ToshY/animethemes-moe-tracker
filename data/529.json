{"id":529,"name":"Cutey Honey F","slug":"cutey_honey_f","synopsis":"On her sixteenth birthday, Honey Kisaragi goes to meet her father. However, he shows up injured and on the run. Out of nowhere, a group of thugs and a monster show up. A detective, Seiji Hayama, rescues Honey and her father. Unfortunately, the monster captures Honey`s father. A grieving Honey goes home to find it in ruins, but a handsome man gives her hope and a device to use against the monsters who took her father. With them, Honey can transform into multiple forms and destroy Panther Zora, the evil behind this. \n\n(Source: AnimeNfo)","format":"TV","season":"WINTER","year":1997,"createdAt":"2021-03-27 00:43:38","updatedAt":"2021-03-28 01:14:46","resources":{"nodes":[{"site":"MAL","externalId":1853},{"site":"ANILIST","externalId":1853},{"site":"KITSU","externalId":1670},{"site":"ANIDB","externalId":1238},{"site":"ANN","externalId":565},{"site":"ANIME_PLANET","externalId":2262}]},"images":{"nodes":[{"id":1053,"facet":"LARGE_COVER","path":"anime/large-cover/ciIx8Hv9xv3hBNUSSivhYlGoCAtrAA4QKIqSXdzQ.jpg"},{"id":1054,"facet":"SMALL_COVER","path":"anime/small-cover/QtendzIx1zbkvYjTduQf42rP59CXGWkT9lEuQRuZ.avif"}]},"studios":{"nodes":[{"id":38,"name":"Toei Animation","slug":"toei_animation"}]},"series":{"nodes":[{"id":27,"name":"Cutey Honey","slug":"cutey_honey"}]},"animethemes":[{"id":610,"slug":"OP1","type":"OP","sequence":null,"song":{"id":610,"title":"Cutey Honey","titleNative":null},"animethemeentries":[{"id":676,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":12937,"basename":"CuteyHoneyFlash-OP1.webm","filename":"CuteyHoneyFlash-OP1","link":"https://v.animethemes.moe/CuteyHoneyFlash-OP1.webm","mimetype":"video/webm","size":26846059,"resolution":480,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"DVD","tags":"DVD480","audio":{"id":10837,"basename":"CuteyHoneyFlash-OP1.ogg","filename":"CuteyHoneyFlash-OP1","link":"https://a.animethemes.moe/CuteyH