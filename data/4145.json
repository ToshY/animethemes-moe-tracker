{"id":4145,"name":"Overtake!","slug":"overtake","synopsis":"Haruka Asahina is a 16 year old high school boy racing F4 cars while staying at Komaki Motos, an auto-body shop in Shizuoka prefecture. Komaki Motors is a family-run shop that regularly competes in F4 with the team comprised of: owner Futoshi Komaki who is also a mechanic, his daugter Mako Komaki, and now Haruka Asahina. Because this is a family-run business, they receive no support usually from any major manufacturers. Haruka Asahina boldly confronts the top teams head-on to get the attention of these revered companies in hopes of making it to the podium himself. \n\r\n\n\r\n(Source: Crunchyroll)","format":"TV","season":"FALL","year":2023,"createdAt":"2023-10-01 06:52:43","updatedAt":"2024-03-22 21:13:25","resources":{"nodes":[{"site":"MAL","externalId":54301},{"site":"KITSU","externalId":47018},{"site":"ANILIST","externalId":160515},{"site":"ANIDB","externalId":17833},{"site":"ANN","externalId":26982},{"site":"X","externalId":null},{"site":"OFFICIAL_SITE","externalId":null},{"site":"ANIME_PLANET","externalId":22951},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":11401,"facet":"LARGE_COVER","path":"anime/large-cover/rhQIpOR2quBieqzbvwav7gRPHtEIUKmIcsEWenTH.jpg"},{"id":11402,"facet":"SMALL_COVER","path":"anime/small-cover/vNkhTOslhWBlNMdXY44o9MjbXkb5NVtMJDbj7t4v.avif"}]},"studios":{"nodes":[{"id":55,"name":"TROYCA","slug":"troyca"}]},"series":{"nodes":[]},"animethemes":[{"id":12547,"slug":"OP1","type":"OP","sequence":null,"song":{"id":12507,"title":"Tailwind","titleNative":null},"animethemeentries":[{"id":14671,"version":1,"episodes":"1-8, 10-12","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":17241,"basename":"Overtake-OP1.webm","filename":"Overtake-OP1","link":"https://v.animethemes.moe/Overtake-OP1.webm","mimetype":"video/webm","size":34438083,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags":"","audio":{"id":12687,"basename":"Over