{"id":255,"title":{"romaji":"Battery","english":"BATTERY the animation","native":"バッテリー"},"slug":"battery","synopsis":"Asano's novels revolve around Takumi Harada, a young man who moves to a mountain town in Okayama prefecture during the spring break before he enters middle school due to his father's job transfer. Takumi is a pitcher, and after the moves he loses faith in his own talent, when suddenly his classmate Gou Nagakura appears in front of him. Gou has a strong desire to form a \"battery\" (a combination of a pitcher and catcher) with Takumi.\n\n(Source: Anime News Network)","format":"TV","season":"SUMMER","year":2016,"createdAt":"2021-03-27 00:43:31","updatedAt":"2021-03-28 00:26:26","resources":{"nodes":[{"site":"MAL","externalId":32947},{"site":"ANILIST","externalId":21702},{"site":"KITSU","externalId":11938},{"site":"ANIDB","externalId":11996},{"site":"ANN","externalId":18153},{"site":"ANIME_PLANET","externalId":7780},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"AMAZON_PRIME_VIDEO","externalId":null}]},"images":{"nodes":[{"id":509,"facet":"LARGE_COVER","path":"anime/large-cover/B1KzYR2VU88nPwqkYjzYsXIyhLgxIihMp4rJKBh6.png"},{"id":510,"facet":"SMALL_COVER","path":"anime/small-cover/UPcJOs2oB3DmPLS4IgvIeTmltVUZMJEtXWOQJGB1.avif"}]},"studios":{"nodes":[{"id":95,"name":"Zero-G","slug":"zero_g"}]},"series":{"nodes":[]},"animethemes":[{"id":6786,"slug":"OP1","type":"OP","sequence":null,"song":{"id":6786,"title":{"romaji":"Itsuka no Jibun","native":null}},"animethemeentries":[{"id":7886,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":7111,"basename":"Battery-OP1.webm","filename":"Battery-OP1","link":"https://v.animethemes.moe/Battery-OP1.webm","mimetype":"video/webm","size":28568669,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags":"","audio":{"id":6121,"basename":"Battery-OP1.ogg","filename":"Battery-OP1","link":"https://a.animethemes.moe/Batt