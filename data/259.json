{"id":259,"name":"Beastars","slug":"beastars","synopsis":"In a world populated by anthropomorphic animals, herbivores and carnivores coexist with each other. For the adolescents of Cherryton Academy, school life is filled with hope, romance, distrust, and uneasiness.\n\nThe main character is Legoshi the wolf, a member of the drama club. Despite his menacing appearance, he has a very gentle heart. Throughout most of his life, he has always been an object of fear and hatred by other animals, and he’s been quite accustomed to that lifestyle. But soon, he finds himself becoming more involved with his fellow classmates who have their own share of insecurities and finds his life in school changing slowly.\n\n(Source: moetron)","format":"TV","season":"FALL","year":2019,"createdAt":"2021-03-27 00:43:31","updatedAt":"2021-03-28 00:27:02","resources":{"nodes":[{"site":"MAL","externalId":39195},{"site":"ANILIST","externalId":107660},{"site":"KITSU","externalId":42147},{"site":"ANIDB","externalId":14659},{"site":"ANN","externalId":21880},{"site":"ANIME_PLANET","externalId":12887},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"NETFLIX","externalId":81054847}]},"images":{"nodes":[{"id":517,"facet":"LARGE_COVER","path":"anime/large-cover/zLzyhcaEhTz2g2ZuMACUzEPXRd15otXxcotjk3l1.png"},{"id":518,"facet":"SMALL_COVER","path":"anime/small-cover/V9I0G6ssabTHYLiIFQ03ZbIRr9BvA1dZpSjU1twj.avif"}]},"studios":{"nodes":[{"id":29,"name":"Orange","slug":"orange"}]},"series":{"nodes":[{"id":365,"name":"Beastars","slug":"beastars"}]},"animethemes":[{"id":8781,"slug":"OP1","type":"OP","sequence":null,"song":{"id":8782,"title":"Wild Side","titleNative":null},"animethemeentries":[{"id":10314,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":10222,"basename":"Beastars-OP1-NCBD1080.webm","filename":"Beastars-OP1-NCBD1080","link":"https://v.animethemes.moe/Beastars-OP1-NCBD1080.webm","mimetype":"video/webm","size":65943891,"resolution