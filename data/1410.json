{"id":1410,"name":"Kamichama Karin","slug":"kamichama_karin","synopsis":"Karin Hanazono is an orphan, living with her relatives. Her life has never been easy, her studies are not well, she is not the best in sports and technically she is miserable. Left with only a ring as a memento from her departed mother, she suddenly finds her life changed, as she was mourning her pet cat, Shii-chan. On that night she met a strange boy, Kazune Kujyou. After that event, she experiences several mysterious incidences that soon led her to find out that she is a little goddess. Finding others like her she soon sets out to understand herself better as her mysterious powers grow and she becomes beset by opponents. \n\n(Source: Anime News Network)","format":"TV","season":"SPRING","year":2007,"createdAt":"2021-03-27 00:44:01","updatedAt":"2021-03-28 03:54:03","resources":{"nodes":[{"site":"MAL","externalId":1808},{"site":"ANILIST","externalId":1808},{"site":"KITSU","externalId":1627},{"site":"ANIDB","externalId":4893},{"site":"ANN","externalId":7461},{"site":"ANIME_PLANET","externalId":1085}]},"images":{"nodes":[{"id":2811,"facet":"LARGE_COVER","path":"anime/large-cover/dhKIsS7sOpLhEwy7Q7C7l0tGrmhcEzacAvVGJcw9.png"},{"id":2812,"facet":"SMALL_COVER","path":"anime/small-cover/JONlFjleZVGyeQd5clSgRWErQX2ZGPHuGHfFAwjk.avif"}]},"studios":{"nodes":[{"id":52,"name":"Satelight","slug":"satelight"}]},"series":{"nodes":[]},"animethemes":[{"id":2769,"slug":"OP1","type":"OP","sequence":null,"song":{"id":2769,"title":"Ankoku Tengoku","titleNative":null},"animethemeentries":[{"id":3110,"version":1,"episodes":"1-25","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":1810,"basename":"KamichamaKarin-OP1.webm","filename":"KamichamaKarin-OP1","link":"https://v.animethemes.moe/KamichamaKarin-OP1.webm","mimetype":"video/webm","size":26165521,"resolution":480,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"DVD","tags":"NCDVD480","audio":{"id":1729,"basename":"KamichamaKarin-OP1.ogg","fil