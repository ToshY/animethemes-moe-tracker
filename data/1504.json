{"id":1504,"name":"Kimi ga Nozomu Eien","slug":"kimi_ga_nozomu_eien","synopsis":"At first, Takayuki Narumi is befriended by Mitsuki Hayase only because Mitsuki's best friend, Haruka Suzumiya has a crush on him; however since then, Takayuki, his pal Shinji Taira, and Mitsuki have grown to be the best of friends. Then one day, Haruka confesses to Takayuki her love for him. Not wanting to hurt her feelings, Takayuki agrees to go out with her. After a few incidents, their relationship gets intimate, even while Takayuki and Mitsuki begin to realize their feelings for each other. But suddenly, when tragedy strikes, things are never the same for these four friends again. \n","format":"TV","season":"FALL","year":2003,"createdAt":"2021-03-27 00:44:04","updatedAt":"2021-03-28 04:10:48","resources":{"nodes":[{"site":"MAL","externalId":147},{"site":"ANILIST","externalId":147},{"site":"KITSU","externalId":125},{"site":"ANIDB","externalId":896},{"site":"ANN","externalId":2570},{"site":"ANIME_PLANET","externalId":443},{"site":"HULU","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":2999,"facet":"LARGE_COVER","path":"anime/large-cover/Prf4U0lyIkpW6UbejAhwdS5VgIDtIqJll343ZePw.png"},{"id":3000,"facet":"SMALL_COVER","path":"anime/small-cover/Ciu4KaksVDeRzCX52n8eRxG7zdHAGw4leMEn3534.avif"}]},"studios":{"nodes":[{"id":35,"name":"Studio Fantasia","slug":"studio_fantasia"}]},"series":{"nodes":[{"id":87,"name":"Kimi ga Nozomu Eien","slug":"kiminozu"}]},"animethemes":[{"id":1670,"slug":"OP1","type":"OP","sequence":null,"song":{"id":1670,"title":"Precious Memories","titleNative":null},"animethemeentries":[{"id":1843,"version":1,"episodes":"3-6","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":557,"basename":"KimiNozo-OP1.webm","filename":"KimiNozo-OP1","link":"https://v.animethemes.moe/KimiNozo-OP1.webm","mimetype":"video/webm","size":46063168,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","