{"id":2760,"name":"Starship Operators","slug":"starship_operators","synopsis":"For the 73rd class of cadets of the Defense University of the small planet Kibi, a shakedown cruise on the fleet's new starship \"Amaterasu\" is a fitting lead-up to graduation. As they are returning to their home planet, however, they are shocked to hear news of a declaration of war by the aggressive Kingdom against Kibi. When their planetary government surrenders without a struggle, the cadets decide to launch their own war, aboard the \"Amaterasu\". To gain funding, they make a deal with a galactic news network - and find themselves the \"stars\" of their own \"reality show\". Unfortunately, this is the kind of reality show that can get you killed...\n\n\n(Source: Anime News Network)","format":"TV","season":"WINTER","year":2005,"createdAt":"2021-03-27 00:44:38","updatedAt":"2021-03-28 08:16:23","resources":{"nodes":[{"site":"MAL","externalId":342},{"site":"ANILIST","externalId":342},{"site":"KITSU","externalId":309},{"site":"ANIDB","externalId":2745},{"site":"ANN","externalId":4811},{"site":"ANIME_PLANET","externalId":1035}]},"images":{"nodes":[{"id":5507,"facet":"LARGE_COVER","path":"anime/large-cover/CAFv0bPflTRTLhlhW8uuPIBcB2FvWCj4moLAStws.jpg"},{"id":5508,"facet":"SMALL_COVER","path":"anime/small-cover/WeEmbddZHUaHLOuWDBcn8MVtohIzhEWGOYEmEFGe.avif"}]},"studios":{"nodes":[{"id":34,"name":"J.C.Staff","slug":"jcstaff"}]},"series":{"nodes":[]},"animethemes":[{"id":2242,"slug":"OP1","type":"OP","sequence":null,"song":{"id":2242,"title":"radiance","titleNative":null},"animethemeentries":[{"id":2529,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":1261,"basename":"StarshipOperators-OP1.webm","filename":"StarshipOperators-OP1","link":"https://v.animethemes.moe/StarshipOperators-OP1.webm","mimetype":"video/webm","size":12113463,"resolution":480,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"DVD","tags":"NCDVD480","audio":{"id":1213,"basen