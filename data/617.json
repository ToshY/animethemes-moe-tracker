{"id":617,"name":"Dimension W","slug":"dimension_w","synopsis":"In the year 2071, the world's energy problems seem solved by a network of cross-dimensional electric-field inductors- \"coils\" -that extract energy from a seemingly infinite source. That source is the W dimension, a fourth plane that exists beyond the X, Y, and Z dimensions.\n\nIn this world, unofficial \"illegal\" coils harness powers that the police can't hope to counter. Dealing with these coils is the job of coil-hating repo man Kyoma, whose run-in with the unique coil android Mira leads the two to form a reluctant partnership.\n\n(Source: FUNimation)","format":"TV","season":"WINTER","year":2016,"createdAt":"2021-03-27 00:43:40","updatedAt":"2021-03-28 01:30:22","resources":{"nodes":[{"site":"MAL","externalId":31163},{"site":"ANILIST","externalId":21256},{"site":"KITSU","externalId":11170},{"site":"ANIDB","externalId":11345},{"site":"ANN","externalId":17285},{"site":"ANIME_PLANET","externalId":7317},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"AMAZON_PRIME_VIDEO","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":1229,"facet":"LARGE_COVER","path":"anime/large-cover/8qQqI6etbI71dBZ0LKYpydpDJ52CYob0E1L3QW1l.jpg"},{"id":1230,"facet":"SMALL_COVER","path":"anime/small-cover/ajJXmKewJJMCzRK4PdgkHQy5Ez40WV9XbAOYFg3S.avif"}]},"studios":{"nodes":[{"id":19,"name":"Studio 3Hz","slug":"studio_3hz"},{"id":29,"name":"Orange","slug":"orange"}]},"series":{"nodes":[{"id":526,"name":"Dimension W","slug":"dimension_w"}]},"animethemes":[{"id":7123,"slug":"OP1","type":"OP","sequence":null,"song":{"id":7124,"title":"Genesis","titleNative":null},"animethemeentries":[{"id":8276,"version":1,"episodes":"1-3","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":7359,"basename":"DimensionW-OP1.webm","filename":"DimensionW-OP1","link":"https://v.animethemes.moe/DimensionW-OP1.webm","mimetype":"video/webm","size":60923622,"resolution":1080,"nc":true,"sub