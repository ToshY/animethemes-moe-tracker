{"id":1830,"title":{"romaji":"Mama wa Shougaku 4 Nensei","english":null,"native":null},"slug":"mama_wa_shougaku_4_nensei","synopsis":"Natsumi Mizuki is a 4th grader whose parents have gone to London. Her Aunt Izumi comes to live with her. Izumi is an aspiring manga writer who is trying to get her first big break, so she doesn't have time for a baby that appears out of thin air on Natsumi's first night alone. The baby's name is Mirai and her mother is *Natsumi*, but 15 years older. Somehow, Mirai had traveled back in time. Now the young Natsumi has to raise Mirai while trying to keep her 4th grade life from falling apart and keep Mirai-chan secret from everyone. She has the dubious help of Izumi and some baby-care gadgets from the future.\n\n\n(Source: Anime News Network)","format":"TV","season":"WINTER","year":1992,"createdAt":"2021-03-27 00:44:13","updatedAt":"2021-03-28 05:11:38","resources":{"nodes":[{"site":"MAL","externalId":333},{"site":"ANILIST","externalId":333},{"site":"KITSU","externalId":300},{"site":"ANIDB","externalId":1344},{"site":"ANN","externalId":1952},{"site":"ANIME_PLANET","externalId":1405}]},"images":{"nodes":[{"id":3651,"facet":"LARGE_COVER","path":"anime/large-cover/J7KRVPfkQc8NPpELZDVfs3UVXvoMHZimWTxBiEmU.jpg"},{"id":3652,"facet":"SMALL_COVER","path":"anime/small-cover/l26IGfnO24QDJy6wg6f8dcLERJs7c8kxzyAPYwZC.avif"}]},"studios":{"nodes":[{"id":25,"name":"Sunrise","slug":"sunrise"}]},"series":{"nodes":[]},"animethemes":[{"id":872,"slug":"OP1","type":"OP","sequence":null,"song":{"id":872,"title":{"romaji":"Ai wo + One","native":null}},"animethemeentries":[{"id":959,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":13252,"basename":"MamawaShougaku4Nensei-OP1.webm","filename":"MamawaShougaku4Nensei-OP1","link":"https://v.animethemes.moe/MamawaShougaku4Nensei-OP1.webm","mimetype":"video/webm","size":30234405,"resolution":480,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"DVD","tags":"DVD480","a