{"id":642,"title":{"romaji":"Dorohedoro","english":null,"native":null},"slug":"dorohedoro","synopsis":"The story revolves around Kaiman, who does not remember who he was before he was transfigured by a Magic user. This transformation left him with a reptile's head, and a desire to find out the truth about who he really is. Accompanied by Nikaido, his female companion, he tracks down Magic Users in \"The Hole\" and unceremoniously chomps down on their head, hoping to find out who it was that put him in this state. One by one, they witness this \"second man\" inside the head of Kaiman, and after pulling them back out of his mouth he asks them all a question... \"What did the guy inside my head say?\"\n","format":"TV","season":"WINTER","year":2020,"createdAt":"2021-03-27 00:43:41","updatedAt":"2021-03-28 01:34:52","resources":{"nodes":[{"site":"MAL","externalId":38668},{"site":"ANILIST","externalId":105228},{"site":"KITSU","externalId":42040},{"site":"ANIDB","externalId":14483},{"site":"ANN","externalId":22562},{"site":"ANIME_PLANET","externalId":12201},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"NETFLIX","externalId":80991903}]},"images":{"nodes":[{"id":1279,"facet":"LARGE_COVER","path":"anime/large-cover/L72SfAlYGITUPYU7ZFosutQVVVrFiQ6mJycmCrDE.jpg"},{"id":1280,"facet":"SMALL_COVER","path":"anime/small-cover/jj7NRxW2wzwwhDHluog5CIqaBMaMjzyzylHatBvF.avif"}]},"studios":{"nodes":[{"id":89,"name":"MAPPA","slug":"mappa"}]},"series":{"nodes":[{"id":695,"name":"Dorohedoro","slug":"dorohedoro"}]},"animethemes":[{"id":9972,"slug":"OP1","type":"OP","sequence":null,"song":{"id":9973,"title":{"romaji":"Welcome to Chaos","native":null}},"animethemeentries":[{"id":11689,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":11889,"basename":"Dorohedoro-OP1-NCBD1080.webm","filename":"Dorohedoro-OP1-NCBD1080","link":"https://v.animethemes.moe/Dorohedoro-OP1-NCBD1080.webm","mimetype":"video/webm","size":62204949,"resol