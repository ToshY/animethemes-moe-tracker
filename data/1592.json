{"id":1592,"name":"Kono Subarashii Sekai ni Shukufuku wo!: Kurenai Densetsu","slug":"kono_subarashii_sekai_ni_shukufuku_wo_kurenai_densetsu","synopsis":"A video game-loving shut-in, Satou Kazuma's life should've ended when he was hit by a truck, but through a twist of fate, he ends up reincarnating in another world--and dragging the troublemaking goddess, Aqua, the wildly dorky mage, Megumin, and the unrelentingly delusional lady knight, Darkness, with him.\n\nNow, the Crimson Demon village that Megumin and Yunyun are from is facing a threat that could mean its ending. Kazuma and his gang follow Yunyun, who returns to the Crimson Demon village intent on saving it... when they are faced with their greatest threat yet! What will become of the unremarkable adventurer Kazuma's life in another world?!\n\n(Source: Crunchyroll)","format":"MOVIE","season":"SUMMER","year":2019,"createdAt":"2021-03-27 00:44:06","updatedAt":"2021-03-28 04:27:39","resources":{"nodes":[{"site":"MAL","externalId":38040},{"site":"ANILIST","externalId":102976},{"site":"KITSU","externalId":41440},{"site":"ANIDB","externalId":13310},{"site":"ANN","externalId":21138},{"site":"ANIME_PLANET","externalId":9031},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":3175,"facet":"LARGE_COVER","path":"anime/large-cover/BwoPCFfwtBF22OhH4MIPtfeORdtJk3Mqe4nVo1MJ.png"},{"id":3176,"facet":"SMALL_COVER","path":"anime/small-cover/fcDvR6kcO1OJME0O0cP9XawKbwAYp4tvHpHKP5U3.avif"}]},"studios":{"nodes":[{"id":34,"name":"J.C.Staff","slug":"jcstaff"}]},"series":{"nodes":[{"id":91,"name":"Kono Subarashii Sekai ni Shukufuku wo!","slug":"konosuba"}]},"animethemes":[{"id":9006,"slug":"ED1","type":"ED","sequence":1,"song":{"id":9007,"title":"My Home Town","titleNative":null},"animethemeentries":[{"id":10588,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":10901,"basename":"KonosubaKurenaiDensetsu-ED1.webm",