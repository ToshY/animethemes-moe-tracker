{"id":3563,"name":"Oshiete Hokusai! The Animation","slug":"oshiete_hokusai_the_animation","synopsis":"The story follows Tenkorin Okakura, a high school slacker girl. While dreaming of a painter god, she makes a wish that her dreams can come true without practice or effort. The god Raijin hears her wish, summons real-life historical artists, and tells Tenkorin to have these artists teach her so that she can fulfill her dreams. Guided by their teachings, Tenkorin aims to become a real painter with a promising future.","format":"ONA","season":"WINTER","year":2021,"createdAt":"2021-11-08 08:09:21","updatedAt":"2021-11-08 09:05:11","resources":{"nodes":[{"site":"MAL","externalId":41250},{"site":"ANILIST","externalId":130707},{"site":"ANIDB","externalId":15385},{"site":"KITSU","externalId":44158},{"site":"ANN","externalId":24031},{"site":"ANIME_PLANET","externalId":15968},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null}]},"images":{"nodes":[{"id":8064,"facet":"LARGE_COVER","path":"anime/large-cover/0OwRL0ANIo78TI835IrtntZeMl9Yu8XfNwaqEChf.jpg"},{"id":8065,"facet":"SMALL_COVER","path":"anime/small-cover/4cXKU9ojvurQc82CEeik1DMQtb5iLXuAmphQMTwg.avif"}]},"studios":{"nodes":[{"id":122,"name":"CoMix Wave Films","slug":"comix_wave_films"}]},"series":{"nodes":[]},"animethemes":[{"id":10878,"slug":"OP1","type":"OP","sequence":null,"song":{"id":10886,"title":"Tenkorin no Theme","titleNative":null},"animethemeentries":[{"id":12676,"version":1,"episodes":"1-10","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":14674,"basename":"OshieteHokusai-OP1.webm","filename":"OshieteHokusai-OP1","link":"https://v.animethemes.moe/OshieteHokusai-OP1.webm","mimetype":"video/webm","size":33034561,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags":"","audio":{"id":9718,"basename":"OshieteHokusai-OP1.ogg","filename":"OshieteHokusai-OP1","link":"https://a.animethemes.moe/OshieteHokusai-OP1.ogg","mimetype":"audio/ogg","size":159