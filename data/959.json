{"id":959,"name":"Gokusen","slug":"gokusen","synopsis":"Kumiko \"Yankumi\" Yamaguchi enters Shirokin Gakuen Private School to become a math teacher. She's assigned as the homeroom teacher for class 2-4, populated by a gang of delinquents. At first, the class tries everything to rattle her cage, but to no avail. In a short period of time, Yankumi gains the respect of the class. But what the school doesn't know is that she's the heir to the Oedo Group, a powerful Yakuza clan. So while Yankumi struggles to excel in her career as a teacher, she must also keep her Yakuza background a secret.\n\n(Source: Anime News Network)","format":"TV","season":"WINTER","year":2004,"createdAt":"2021-03-27 00:43:49","updatedAt":"2021-03-28 02:31:52","resources":{"nodes":[{"site":"MAL","externalId":242},{"site":"ANILIST","externalId":242},{"site":"KITSU","externalId":217},{"site":"ANIDB","externalId":1330},{"site":"ANN","externalId":3371},{"site":"ANIME_PLANET","externalId":825},{"site":"OFFICIAL_SITE","externalId":null}]},"images":{"nodes":[{"id":1909,"facet":"LARGE_COVER","path":"anime/large-cover/iFL3F3BOqn2GsYPlqAmISQiPF5vr1Og9pm9RkDab.jpg"},{"id":1910,"facet":"SMALL_COVER","path":"anime/small-cover/WCqC4bpBh9j2DxRCv6GlCzxXx8HSzaxJP04BeycM.avif"}]},"studios":{"nodes":[{"id":23,"name":"Madhouse","slug":"madhouse"}]},"series":{"nodes":[]},"animethemes":[{"id":2046,"slug":"OP1","type":"OP","sequence":null,"song":{"id":2046,"title":"Honto no Kotoba","titleNative":null},"animethemeentries":[{"id":2284,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":1013,"basename":"Gokusen-OP1.webm","filename":"Gokusen-OP1","link":"https://v.animethemes.moe/Gokusen-OP1.webm","mimetype":"video/webm","size":39205526,"resolution":720,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"DVD","tags":"NCDVD","audio":{"id":983,"basename":"Gokusen-OP1.ogg","filename":"Gokusen-OP1","link":"https://a.animethemes.moe/Gokusen-OP1.ogg","mimetype":"audio/ogg","size":32219