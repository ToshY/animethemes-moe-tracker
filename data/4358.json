{"id":4358,"name":"Shikanoko Nokonoko Koshitantan","slug":"shikanoko_nokonoko_koshitantan","synopsis":"Girl meets elk-girl—and chaos ensues!\n\nNo one knows Torako used to be a delinquent. All of her classmates only know her as the perfect student. But everything changes when Nokotan, a transfer student with antlers, enters her life. Antlers aren’t the only thing strange about Nokotan. Her deer nose can sniff out Torako’s secret past! Whether it’s at school or the zoo, chaos follows this doe-eyed girl’s every step. Torako has so many questions! Is Nokotan a deer, a girl, or something in-between?\n\n(Source: Seven Seas Entertainment)","format":"TV","season":"SUMMER","year":2024,"createdAt":"2024-07-07 17:32:00","updatedAt":"2024-07-07 17:32:00","resources":{"nodes":[{"site":"MAL","externalId":58426},{"site":"KITSU","externalId":48618},{"site":"ANILIST","externalId":175977},{"site":"ANIDB","externalId":18534},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null},{"site":"AMAZON_PRIME_VIDEO","externalId":null},{"site":"ANIME_PLANET","externalId":24466},{"site":"ANN","externalId":32422}]},"images":{"nodes":[{"id":11946,"facet":"LARGE_COVER","path":"anime/large-cover/iXaecUXa9abRqkDSdq9j2KuO442Qax7Y6l1RbP1T.jpg"},{"id":11947,"facet":"SMALL_COVER","path":"anime/small-cover/noxnljWu3e2ZTzjvQrT6XVUBHVWMwjCSVQisroZo.avif"}]},"studios":{"nodes":[{"id":202,"name":"Wit Studio","slug":"wit_studio"}]},"series":{"nodes":[]},"animethemes":[{"id":13032,"slug":"OP1","type":"OP","sequence":null,"song":{"id":12981,"title":"Shika-iro Days","titleNative":null},"animethemeentries":[{"id":15234,"version":1,"episodes":"1-12","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":17960,"basename":"Shikanoko-OP1.webm","filename":"Shikanoko-OP1","link":"https://v.animethemes.moe/Shikanoko-OP1.webm","mimetype":"video/webm","size":33293490,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags":"