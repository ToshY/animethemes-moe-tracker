{"id":1321,"name":"Jigoku Shoujo","slug":"jigoku_shoujo","synopsis":"Somewhere in the vast sea of the Internet, there's a website that can only be accessed at the stroke of midnight. Known as the Jigoku Tsushin, rumor has it that if you post a grudge there, the Jigoku Shoujo will appear and drag whoever torments you into the inferno. Very little is known about the girl - all we know for sure is that she lives with her equally enigmatic grandmother, that three magical straw dolls accompany and serve her, and that whenever a posting on the Jigoku Tsushin moves her, she becomes the Jigoku Shoujo. \n","format":"TV","season":"FALL","year":2005,"createdAt":"2021-03-27 00:43:58","updatedAt":"2021-03-28 03:37:02","resources":{"nodes":[{"site":"MAL","externalId":228},{"site":"ANILIST","externalId":228},{"site":"KITSU","externalId":203},{"site":"ANIDB","externalId":3291},{"site":"ANN","externalId":5577},{"site":"ANIME_PLANET","externalId":991},{"site":"AMAZON_PRIME_VIDEO","externalId":null}]},"images":{"nodes":[{"id":2633,"facet":"LARGE_COVER","path":"anime/large-cover/yCTJkAVChFfM6kBO9LMufbcTLz5MgBLqbXVgEjCj.jpg"},{"id":2634,"facet":"SMALL_COVER","path":"anime/small-cover/YZNT27kYxAKuwHIWHZRR1Zpb5SkZFnbPWo3fkzn8.avif"}]},"studios":{"nodes":[{"id":2,"name":"Studio Deen","slug":"studio_deen"}]},"series":{"nodes":[{"id":79,"name":"Jigoku Shoujo","slug":"jigoku_shoujo"}]},"animethemes":[{"id":2084,"slug":"OP1","type":"OP","sequence":null,"song":{"id":2084,"title":"Sakasama no Chou","titleNative":null},"animethemeentries":[{"id":2327,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":1058,"basename":"JigokuShoujo-OP1.webm","filename":"JigokuShoujo-OP1","link":"https://v.animethemes.moe/JigokuShoujo-OP1.webm","mimetype":"video/webm","size":10930333,"resolution":480,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"DVD","tags":"NCDVD480","audio":{"id":1027,"basename":"JigokuShoujo-OP1.ogg","filename":"JigokuShoujo-OP1","link":"https:/