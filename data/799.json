{"id":799,"name":"Fune wo Amu","slug":"fune_wo_amu","synopsis":"The series follows the employees at the Genbu Shobō publishing company. Araki, who is a veteran editor for the dictionary department, is looking for a successor now that he's approaching retirement age. After Majime Mitsuya — a salesman who's a poor talker — meets Masashi Nishioka — Araki's coworker who is sociable and frivolous — Araki overhears their conversation and decides to recruit Majime into the department. The story follows \"the awkward humans\" Majime and Masashi as they work together to compile a medium-sized Japanese dictionary titled \"The Great Passage\" (Daitokai). \n\n\n(Source: Anime News Network)","format":"TV","season":"FALL","year":2016,"createdAt":"2021-03-27 00:43:45","updatedAt":"2021-03-28 02:03:20","resources":{"nodes":[{"site":"MAL","externalId":32948},{"site":"ANILIST","externalId":21703},{"site":"KITSU","externalId":11939},{"site":"ANIDB","externalId":11997},{"site":"ANN","externalId":18698},{"site":"ANIME_PLANET","externalId":7779},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"AMAZON_PRIME_VIDEO","externalId":null}]},"images":{"nodes":[{"id":1593,"facet":"LARGE_COVER","path":"anime/large-cover/17kdlidpL5EslseAGLcVG1HXQpPRx95KJlY8GPBp.jpg"},{"id":1594,"facet":"SMALL_COVER","path":"anime/small-cover/cPWzsQm9qqdd9at8d7ViJUwWtQjqNnUMaQcVpDiX.avif"}]},"studios":{"nodes":[{"id":54,"name":"Zexcs","slug":"zexcs"}]},"series":{"nodes":[]},"animethemes":[{"id":6635,"slug":"OP1","type":"OP","sequence":null,"song":{"id":6635,"title":"Shiokaze","titleNative":null},"animethemeentries":[{"id":7711,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":6664,"basename":"FuneWoAmu-OP1.webm","filename":"FuneWoAmu-OP1","link":"https://v.animethemes.moe/FuneWoAmu-OP1.webm","mimetype":"video/webm","size":42894740,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":5