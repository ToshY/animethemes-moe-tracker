{"id":4280,"name":"Jiisan Baasan Wakagaeru","slug":"jiisan_baasan_wakagaeru","synopsis":"Shouzou and Ine Saitou have been happily married for as long as they can remember. Even in their old age with wrinkles and cracking limbs, the strength of this love is evident by their precious bond. And then, randomly one day, they wake up to find they are young again!\n\r\n\n\r\nDespite their newfound youthful and attractive bodies, Shouzou and Ine remain the same as ever. Jiisan Baasan Wakagaeru follows the young old couple as they go about their daily lives, spend time with family, and defy the expectations of the youngsters.","format":"TV","season":"SPRING","year":2024,"createdAt":"2024-04-08 04:21:27","updatedAt":"2024-05-17 22:47:30","resources":{"nodes":[{"site":"MAL","externalId":56230},{"site":"ANILIST","externalId":168138},{"site":"ANIDB","externalId":18153},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null},{"site":"ANIME_PLANET","externalId":23794},{"site":"ANN","externalId":29353},{"site":"KITSU","externalId":47857}]},"images":{"nodes":[{"id":11722,"facet":"LARGE_COVER","path":"anime/large-cover/MbJruwo0YDzo2SA7hLfAMW32LCO3PBdrAYyvixe9.jpg"},{"id":11723,"facet":"SMALL_COVER","path":"anime/small-cover/RUAWA2ThedBY8E9OydmNRb6yYcyLFY4XQd2I08ZY.avif"}]},"studios":{"nodes":[{"id":388,"name":"Gekkou","slug":"gekkou"}]},"series":{"nodes":[]},"animethemes":[{"id":12839,"slug":"OP1","type":"OP","sequence":null,"song":{"id":12796,"title":"Kimi ga Ojii-chan Atashi ga Obaa-chan","titleNative":null},"animethemeentries":[{"id":15026,"version":1,"episodes":"1-","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":17726,"basename":"JiisanBaasanWakagaeru-OP1.webm","filename":"JiisanBaasanWakagaeru-OP1","link":"https://v.animethemes.moe/JiisanBaasanWakagaeru-OP1.webm","mimetype":"video/webm","size":51118805,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags":"","audio":{"id"