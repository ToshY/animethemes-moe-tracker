{"id":3501,"title":{"romaji":"Megami-ryou no Ryoubo-kun.","english":"Mother of the Goddess’ Dormitory","native":"女神寮の寮母くん。"},"slug":"megami_ryou_no_ryoubo_kun","synopsis":"Down-on-his-luck Koushi Nagumo wanders the streets unemployed, homeless and in search of his next meal. His fortunes improve after a chance meeting with a vivacious young woman whose proposition seemingly solves nearly all his problems. Thanks to her, Koushi enters the welcoming halls of a dormitory at a women’s college… only this particular assignment is no stuffy, sleepy affair. The Goddess’ Dormitory is known for housing the college’s most unruly students! If he wants to keep a roof over his head, Koushi must become the “Dormitory Mother” charged with maintaining order and good discipline. But doing his job and keeping his sanity are no small feat with characters as endearingly eccentric and untamable as these!\n\n(Source: Sentai Filmworks)","format":"TV","season":"SUMMER","year":2021,"createdAt":"2021-09-29 08:08:53","updatedAt":"2021-09-29 09:04:41","resources":{"nodes":[{"site":"MAL","externalId":41812},{"site":"ANILIST","externalId":117989},{"site":"ANIDB","externalId":15522},{"site":"KITSU","externalId":44176},{"site":"ANN","externalId":23959},{"site":"ANIME_PLANET","externalId":14967},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"HIDIVE","externalId":null}]},"images":{"nodes":[{"id":7942,"facet":"LARGE_COVER","path":"anime/large-cover/BqpMIEdmknNA9IcIm7qfj9k5QQlZ1NX1BznV3Qde.jpg"},{"id":7943,"facet":"SMALL_COVER","path":"anime/small-cover/syxeVVu2kEEtLEtvlLZr1g1pNoBiG7OpChOxbpls.avif"}]},"studios":{"nodes":[{"id":73,"name":"asread.","slug":"asread"}]},"series":{"nodes":[]},"animethemes":[{"id":10711,"slug":"OP1","type":"OP","sequence":null,"song":{"id":10720,"title":{"romaji":"Naughty Love","native":null}},"animethemeentries":[{"id":12502,"version":1,"episodes":"1-10","nsfw":true,"spoiler":false,"videos":{"nodes":[{"id":14398,"basename":"MegamiRyouNoRy