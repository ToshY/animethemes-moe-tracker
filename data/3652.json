{"id":3652,"title":{"romaji":"Damekko Doubutsu","english":null,"native":null},"slug":"damekko_doubutsu","synopsis":"Uruno, a useless wolf, is on the road searching for a new place to call home. He soon comes upon a whole forest full of \"useless animals\"-- that is, animals that don't live up to their species' usual character. After a short fight with the smoking, bad-tempered rabbit, Usahara, Uruno decides that he wants to move on... but changes his mind upon meeting Chiiko, a clumsy cheetah girl. It's love at first sight for Uruno, and after deciding to stay for her, he continues to hope that even though he's a good-for-nothing, he'll win her over someday. That is, if living with the other strange residents of the forest-- including the aformentioned smoking rabbit, a sake-drinking unicorn, a near-sighted eagle, an orca that cannot swim, and a shy pegasus --doesn't get to him first.","format":"TV_SHORT","season":"WINTER","year":2005,"createdAt":"2022-01-15 08:09:11","updatedAt":"2022-01-15 09:07:25","resources":{"nodes":[{"site":"MAL","externalId":485},{"site":"ANILIST","externalId":485},{"site":"ANIDB","externalId":2824},{"site":"KITSU","externalId":446},{"site":"ANN","externalId":4994},{"site":"ANIME_PLANET","externalId":1361}]},"images":{"nodes":[{"id":8241,"facet":"LARGE_COVER","path":"anime/large-cover/fxg3qwJLbVThxRNPCqNkAhXNMESdUyxvR98bfOVE.jpg"},{"id":8242,"facet":"SMALL_COVER","path":"anime/small-cover/8ZxV2kuMxLsQhtYWZWdpV2dODaUDqui6UXlUg0Gs.avif"}]},"studios":{"nodes":[{"id":57,"name":"Magic Bus","slug":"magic_bus"}]},"series":{"nodes":[]},"animethemes":[{"id":11117,"slug":"OP1","type":"OP","sequence":null,"song":{"id":11122,"title":{"romaji":"Sekai de Ichiban Boku ga Suki!","native":null}},"animethemeentries":[{"id":12939,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":15016,"basename":"DamekkoDoubutsu-OP1.webm","filename":"DamekkoDoubutsu-OP1","link":"https://v.animethemes.moe/DamekkoDoubutsu-OP1.webm","mimetype":"vid