{"id":2941,"name":"Time Bokan 24","slug":"time_bokan_24","synopsis":"The anime centres on Tokio, a junior high student living in the present time who is suddenly made a member of the 24th century's Space-Time Administration Bureau. Immediately, he learns that the history he has learned in the textbooks is wrong, and there is a more interesting version of history where the peerless beauty Cleopatra is actually the comic duo of Cleo and Patra, Momotarō is more of an ogre than actual ogres. Together with his teammate Karen, they use the 24 Bokan Mecha to search for the True History.\n\n\n(Source: Anime News Network)","format":"TV","season":"FALL","year":2016,"createdAt":"2021-03-27 00:44:43","updatedAt":"2021-03-28 08:48:34","resources":{"nodes":[{"site":"MAL","externalId":33026},{"site":"ANILIST","externalId":21755},{"site":"KITSU","externalId":12204},{"site":"ANIDB","externalId":12032},{"site":"ANN","externalId":18180},{"site":"ANIME_PLANET","externalId":7815},{"site":"OFFICIAL_SITE","externalId":null},{"site":"CRUNCHYROLL","externalId":null},{"site":"X","externalId":null}]},"images":{"nodes":[{"id":5867,"facet":"LARGE_COVER","path":"anime/large-cover/ElltGNOtvrlmjmCDC6PzrvLLrtyWsvLAtR4WOueF.png"},{"id":5868,"facet":"SMALL_COVER","path":"anime/small-cover/8yiU1yBRX1l7hKAhoRizhGwgWHBiV7OgmqASXl8A.avif"}]},"studios":{"nodes":[{"id":47,"name":"Tatsunoko Production","slug":"tatsunoko_production"}]},"series":{"nodes":[{"id":168,"name":"Time Bokan","slug":"time_bokan"}]},"animethemes":[{"id":6740,"slug":"OP1","type":"OP","sequence":1,"song":{"id":6740,"title":"Fantastic Time","titleNative":null},"animethemeentries":[{"id":7835,"version":1,"episodes":"1-13","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":6816,"basename":"TimeBokan24-OP1.webm","filename":"TimeBokan24-OP1","link":"https://v.animethemes.moe/TimeBokan24-OP1.webm","mimetype":"video/webm","size":28423916,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags":"","aud