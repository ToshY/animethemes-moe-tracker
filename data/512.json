{"id":512,"name":"Comic Girls","slug":"comic_girls","synopsis":"The manga's story centers on the 15-year-old high school student and manga creator Kaoruko Moeta, who uses the pen name Chaos. After ranking at the bottom of a reader survey, Kaoruko's editor recommends that she enter an all-female dormitory for manga creators. Kaoruko's roommates are shoujo manga creator Koyume Koizuka, teen romance manga creator Ruki Irokawa, and shounen manga creator Tsubasa Katsuki. The girls support each other as they work to become better manga creators.\n\n\n(Source: Anime News Network)","format":"TV","season":"SPRING","year":2018,"createdAt":"2021-03-27 00:43:38","updatedAt":"2021-03-28 01:11:19","resources":{"nodes":[{"site":"MAL","externalId":35756},{"site":"ANILIST","externalId":99131},{"site":"KITSU","externalId":13722},{"site":"ANIDB","externalId":13238},{"site":"ANN","externalId":20048},{"site":"ANIME_PLANET","externalId":8942},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":1021,"facet":"LARGE_COVER","path":"anime/large-cover/6uDnlDKquyulxCJ2WDadCtNVWPsRPzuBtmM1Y3vK.png"},{"id":1022,"facet":"SMALL_COVER","path":"anime/small-cover/x7F83y1nmxxuwt4jWej5gpf9GZJrgAzwScWmmW2c.avif"}]},"studios":{"nodes":[{"id":145,"name":"Nexus","slug":"nexus"}]},"series":{"nodes":[]},"animethemes":[{"id":8361,"slug":"OP1","type":"OP","sequence":null,"song":{"id":8362,"title":"Memories","titleNative":null},"animethemeentries":[{"id":9765,"version":1,"episodes":"2-6","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":9146,"basename":"ComicGirls-OP1-NCBD1080.webm","filename":"ComicGirls-OP1-NCBD1080","link":"https://v.animethemes.moe/ComicGirls-OP1-NCBD1080.webm","mimetype":"video/webm","size":42026735,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":7383,"basename":"ComicGirls-OP1-NCBD1080.ogg","filename":"ComicGirls-OP1-NCBD1080