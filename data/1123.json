{"id":1123,"title":{"romaji":"Hibike! Euphonium 2","english":"Sound! Euphonium 2","native":"響け！ユーフォニアム 2"},"slug":"hibike_euphonium_2","synopsis":"With another tournament fast approaching, Kumiko's band is doubling down on practice and discipline, leaving little time for sleep or other recreational activities. The redoubled practice schedule brings Kumiko and Reina closer together, but elsewhere in the band, it seems like drama threatens to tear the group's unity apart. The ghost of the prior year's mass band exodus still haunts many of Kumiko's classmates, and with former band member Nozomi Kasaki now asking to return, it seems like the grudges of the past will soon be impossible to ignore.\n\n\n(Source: Anime News Network, edited)\n\n\n\n*Note: The first episode aired with a runtime of ~48 minutes as opposed to the standard 24 minute long episode.*","format":"TV","season":"FALL","year":2016,"createdAt":"2021-03-27 00:43:53","updatedAt":"2021-03-28 03:01:49","resources":{"nodes":[{"site":"MAL","externalId":31988},{"site":"ANILIST","externalId":21460},{"site":"KITSU","externalId":11474},{"site":"ANIDB","externalId":11746},{"site":"ANN","externalId":18558},{"site":"ANIME_PLANET","externalId":7587},{"site":"X","externalId":null},{"site":"OFFICIAL_SITE","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":2237,"facet":"LARGE_COVER","path":"anime/large-cover/NOUBf7M526BCEAcrwdGtJ8CbDXS8BceDwAGtHEsO.png"},{"id":2238,"facet":"SMALL_COVER","path":"anime/small-cover/tHjNNRqy8x1XU6tM2SzKKikZdfdgCdmKnCCLQci3.avif"}]},"studios":{"nodes":[{"id":37,"name":"Kyoto Animation","slug":"kyoto_animation"}]},"series":{"nodes":[{"id":68,"name":"Hibike! Euphonium","slug":"hibike_euphonium"}]},"animethemes":[{"id":6650,"slug":"OP1","type":"OP","sequence":null,"song":{"id":6650,"title":{"romaji":"Soundscape","native":null}},"animethemeentries":[{"id":7735,"version":1,"episodes":"1-5","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":6702,"basename":"Hib