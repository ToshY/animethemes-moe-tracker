{"id":1456,"title":{"romaji":"Katanagatari","english":null,"native":null},"slug":"katanagatari","synopsis":"Yasuri Shichika, seventh successor of the Kyotouryuu (bladeless) sword art, lives on an isolated island with his older sister, Nanami. \n\nOne day Shichika is visited by a woman named Togame, who requests his aid in her quest to find and collect the final twelve swords forged by the legendary master swordsmith, Shikizaki Kiki. Shichika and Togame begin their odyssey by leaving the island he called home for over 20 years. They will face twelve individuals who possess and protect Shikizaki's legendary swords. \n\nJoin Shichika and Togame on an exciting, epic adventure that defies reality as they discover the true potential of the Kyoutoryuu sword style!\n\n(Source: NIS America)","format":"TV","season":"WINTER","year":2010,"createdAt":"2021-03-27 00:44:03","updatedAt":"2021-03-28 04:02:03","resources":{"nodes":[{"site":"MAL","externalId":6594},{"site":"ANILIST","externalId":6594},{"site":"KITSU","externalId":4630},{"site":"ANIDB","externalId":6613},{"site":"ANN","externalId":10765},{"site":"ANIME_PLANET","externalId":2756}]},"images":{"nodes":[{"id":2903,"facet":"LARGE_COVER","path":"anime/large-cover/GLPUDibpHbeiBioeu7wuAyTclKxoEXHaQU8feXjh.png"},{"id":2904,"facet":"SMALL_COVER","path":"anime/small-cover/aIOrcO1uvUvsHsZjNOuoVnaB3w6pmehNA96lECUc.avif"}]},"studios":{"nodes":[{"id":48,"name":"White Fox","slug":"white_fox"}]},"series":{"nodes":[]},"animethemes":[{"id":3915,"slug":"OP1","type":"OP","sequence":1,"song":{"id":3915,"title":{"romaji":"Meiya Kadenrou","native":null}},"animethemeentries":[{"id":4443,"version":1,"episodes":"1-7","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":3263,"basename":"Katanagatari-OP1.webm","filename":"Katanagatari-OP1","link":"https://v.animethemes.moe/Katanagatari-OP1.webm","mimetype":"video/webm","size":62307050,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio