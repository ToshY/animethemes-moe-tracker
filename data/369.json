{"id":369,"name":"Bubuki Buranki","slug":"bubuki_buranki","synopsis":"When Azuma Ikki returns to Japan after 10 years, he gets assaulted by a group of armed men and becomes their prisoner. Kogane Asabuki, a childhood friend, saves him with a weapon on her right hand known as Bubuki; a weapon with its own mind. Azuma Ikki, who is a Bubuki user himself, learns about the existence of Bubuki and goes on a journey alongside the companions he has found, in an attempt to find and revive Oumai, a Buranki (titan) who sleeps underground.\n","format":"TV","season":"WINTER","year":2016,"createdAt":"2021-03-27 00:43:34","updatedAt":"2021-03-28 00:46:05","resources":{"nodes":[{"site":"MAL","externalId":32023},{"site":"ANILIST","externalId":21471},{"site":"KITSU","externalId":11486},{"site":"ANIDB","externalId":11761},{"site":"ANN","externalId":17790},{"site":"ANIME_PLANET","externalId":7599},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":737,"facet":"LARGE_COVER","path":"anime/large-cover/juQCFAvg2fictlYDLVLbMJpWSsmb3xRwwynLZU2E.png"},{"id":738,"facet":"SMALL_COVER","path":"anime/small-cover/c78XildAdmdfPhk6tWv5sDrW5x31bA2WwjoiwiQD.avif"}]},"studios":{"nodes":[{"id":67,"name":"SANZIGEN","slug":"sanzigen"}]},"series":{"nodes":[{"id":375,"name":"Bubuki Buranki","slug":"bubuki_buranki"}]},"animethemes":[{"id":7116,"slug":"OP1","type":"OP","sequence":null,"song":{"id":7117,"title":"Beat your Heart","titleNative":null},"animethemeentries":[{"id":8268,"version":1,"episodes":"1-2","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":7349,"basename":"BubukiBuranki-OP1.webm","filename":"BubukiBuranki-OP1","link":"https://v.animethemes.moe/BubukiBuranki-OP1.webm","mimetype":"video/webm","size":65948053,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":6286,"basename":"BubukiBuranki-OP1.ogg","filename":"BubukiBuranki-OP1","lin