{"id":1421,"name":"Kamisama Hajimemashita","slug":"kamisama_hajimemashita","synopsis":"Nanami Momozono is alone and homeless after her dad skips town to evade his gambling debts and the debt collectors kick her out of her apartment. So when a man she's just saved from a dog offers her his home, she jumps at the opportunity. But it turns out that his place is a shrine, and Nanami has unwittingly taken over his job as a local deity! \n\nNanami has all kinda of new responsibilities she doesn't understand, dangers she's unaware of, and a cranky ex-familiar who's... actually pretty hot. What's a new-fledged godling to do? \n\n(Source: Viz Media) ","format":"TV","season":"FALL","year":2012,"createdAt":"2021-03-27 00:44:02","updatedAt":"2021-03-28 03:56:00","resources":{"nodes":[{"site":"MAL","externalId":14713},{"site":"ANILIST","externalId":14713},{"site":"KITSU","externalId":7157},{"site":"ANIDB","externalId":9298},{"site":"ANN","externalId":14441},{"site":"ANIME_PLANET","externalId":5146},{"site":"HULU","externalId":null},{"site":"CRUNCHYROLL","externalId":null},{"site":"AMAZON_PRIME_VIDEO","externalId":null}]},"images":{"nodes":[{"id":2833,"facet":"LARGE_COVER","path":"anime/large-cover/MbgnbETPOgpMAYCwFNIzk2E526jo4k2WlY7dUoox.jpg"},{"id":2834,"facet":"SMALL_COVER","path":"anime/small-cover/IihJ1YHDaw5zmHeeoCyiO3k2iZrTKBDFo0ltplaP.avif"}]},"studios":{"nodes":[{"id":40,"name":"TMS Entertainment","slug":"tms_entertainment"}]},"series":{"nodes":[{"id":539,"name":"Kamisama Hajimemashita","slug":"kamisama_hajimemashita"}]},"animethemes":[{"id":4497,"slug":"OP1","type":"OP","sequence":null,"song":{"id":4497,"title":"Kamisama Hajimemashita","titleNative":null},"animethemeentries":[{"id":5143,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":3983,"basename":"KamisamaHajimemashita-OP1.webm","filename":"KamisamaHajimemashita-OP1","link":"https://v.animethemes.moe/KamisamaHajimemashita-OP1.webm","mimetype":"video/webm","size":21528433,"resolution"