{"id":3135,"name":"Witch Craft Works","slug":"witch_craft_works","synopsis":"Takamiya Honoka is a regular student whose only problem seems to be that he sits next to Kagari Ayaka, the school's #1 beauty. They have never spoken to each other before and any small interaction between them immediately results in her fanclub beating him. Yet when a falling part of the school's building is about to send him to the afterlife, it's Kagari that comes to his rescue. Only... she's dressed as a witch, carrying him in her arms and floating on a broom?! Kagari tells him it is her mission to protect him and that now she can finally protect him openly rather than undercover.\n","format":"TV","season":"WINTER","year":2014,"createdAt":"2021-03-27 00:44:48","updatedAt":"2021-03-28 09:24:54","resources":{"nodes":[{"site":"MAL","externalId":21085},{"site":"ANILIST","externalId":20503},{"site":"KITSU","externalId":8017},{"site":"ANIDB","externalId":9496},{"site":"ANN","externalId":15708},{"site":"ANIME_PLANET","externalId":5304},{"site":"CRUNCHYROLL","externalId":null},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null}]},"images":{"nodes":[{"id":6255,"facet":"LARGE_COVER","path":"anime/large-cover/HWcM4PJbB5ST377pawmeCkaw3RjvU1eP0rooA2uV.jpg"},{"id":6256,"facet":"SMALL_COVER","path":"anime/small-cover/C6WuORqSk9BThU7DVQEAew6P3hQ7faflIHjP37q9.avif"}]},"studios":{"nodes":[{"id":34,"name":"J.C.Staff","slug":"jcstaff"}]},"series":{"nodes":[]},"animethemes":[{"id":6000,"slug":"OP1","type":"OP","sequence":null,"song":{"id":6000,"title":"divine intervention","titleNative":null},"animethemeentries":[{"id":6915,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":5827,"basename":"WitchCraftWorks-OP1.webm","filename":"WitchCraftWorks-OP1","link":"https://v.animethemes.moe/WitchCraftWorks-OP1.webm","mimetype":"video/webm","size":53055202,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","aud