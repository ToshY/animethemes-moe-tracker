{"id":1259,"title":{"romaji":"Ingress the Animation","english":"Ingress: The Animation","native":"イングレス"},"slug":"ingress_the_animation","synopsis":"Since he was little, Makoto had a strange power which enabled him to read the memories of objects he touched.\nHiding his uncontrollable power, he works as a special agent in the police force. One day, while investigating an explosion at a laboratory that researches a unknown substance called “XM”, he sees a mysterious memory.\nThe memory was from Sarah's ring, who was the sole survivor of the accident.\nIt was a sight of a person being swallowed into a red light and disappearing.\nMakoto becomes embroiled in a massive conspiracy.\nThe battle for “XM”, a material that could affect human mind, starts now――\n\n\n(Source: Official Website)","format":"TV","season":"FALL","year":2018,"createdAt":"2021-03-27 00:43:57","updatedAt":"2021-03-28 03:26:32","resources":{"nodes":[{"site":"MAL","externalId":37438},{"site":"ANILIST","externalId":101500},{"site":"KITSU","externalId":41030},{"site":"ANIDB","externalId":13890},{"site":"ANN","externalId":21121},{"site":"ANIME_PLANET","externalId":9811},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"NETFLIX","externalId":80992853}]},"images":{"nodes":[{"id":2509,"facet":"LARGE_COVER","path":"anime/large-cover/cyV6C7QgGEyIuo0RXuFumuajC7nOsXQrInoARnHg.jpg"},{"id":2510,"facet":"SMALL_COVER","path":"anime/small-cover/pJeeOhrrwp5hj7fjoi9W3kIq7uFxTwkafGlO9ogH.avif"}]},"studios":{"nodes":[{"id":78,"name":"Craftar Studios","slug":"craftar_studios"}]},"series":{"nodes":[]},"animethemes":[{"id":8010,"slug":"OP1","type":"OP","sequence":null,"song":{"id":8011,"title":{"romaji":"Tessellate","native":null}},"animethemeentries":[{"id":9373,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":8878,"basename":"Ingress-OP1.webm","filename":"Ingress-OP1","link":"https://v.animethemes.moe/Ingress-OP1.webm","mimetype":"video/webm","size":37734806