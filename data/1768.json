{"id":1768,"name":"Mahou Sensou","slug":"mahou_sensou","synopsis":"In this modern magic action story, Takeshi Nanase is an ordinary high school boy who has a somewhat dark past. Due to certain circumstances, he formed a \"fake\" couple with his childhood friend Kurumi Isoshima, but otherwise, he lives a normal life. However, one day, he comes across a girl named Mui Aiba, in a uniform he has never seen before, collapsed on the school campus. This encounters changes Takeshi's destiny completely. Mui tells Takeshi that she is a magician, and she apologizes, for she turned Takeshi into a magician, too. What Takeshi once knew as one world is actually two — the world where magicians live and the world where humans live.\n\n(Source: Anime News Network)","format":"TV","season":"WINTER","year":2014,"createdAt":"2021-03-27 00:44:11","updatedAt":"2021-03-28 04:59:40","resources":{"nodes":[{"site":"MAL","externalId":19769},{"site":"ANILIST","externalId":19769},{"site":"KITSU","externalId":7879},{"site":"ANIDB","externalId":9995},{"site":"ANN","externalId":15687},{"site":"ANIME_PLANET","externalId":5711},{"site":"OFFICIAL_SITE","externalId":null},{"site":"HULU","externalId":null},{"site":"HIDIVE","externalId":null}]},"images":{"nodes":[{"id":3527,"facet":"LARGE_COVER","path":"anime/large-cover/3KxYwH2vYCs08viR10Lu0veTZhv7dLAvCRVE3OJp.jpg"},{"id":3528,"facet":"SMALL_COVER","path":"anime/small-cover/VedbyVqmauM0PMZSD10l7lsxldZC8qMgyKZZZQJ4.avif"}]},"studios":{"nodes":[{"id":23,"name":"Madhouse","slug":"madhouse"}]},"series":{"nodes":[]},"animethemes":[{"id":5908,"slug":"OP1","type":"OP","sequence":null,"song":{"id":5908,"title":"Senkou no Prisoner","titleNative":null},"animethemeentries":[{"id":6811,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":5722,"basename":"MahouSensou-OP1.webm","filename":"MahouSensou-OP1","link":"https://v.animethemes.moe/MahouSensou-OP1.webm","mimetype":"video/webm","size":58522986,"resolution":1080,"nc":true,"subbed":fa