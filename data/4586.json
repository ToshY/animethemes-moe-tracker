{"id":4586,"name":"Kyougoku Natsuhiko: Kousetsu Hyaku Monogatari","slug":"kyougoku_natsuhiko_kousetsu_hyaku_monogatari","synopsis":"Tired of writing riddles for children, Yamaoka Momosuke plans on gathering spooky and gruesome stories and publishing them in an anthology called Hyakumonogatari (\"One Hundred Tales\"). While researching these old myths and legends he comes across a mysterious trio who call themselves the Ongyou. They are detectives who are investigating the legends to reveal their truths...and bring those in the wrong to justice. Each time Momosuke meets the Ongyou he must face horrible truths and battle with his morals, but he's seeing things he shouldn't be seeing...\n\n(Source: Anime News Network)","format":"TV","season":"FALL","year":2003,"createdAt":"2025-06-27 20:51:28","updatedAt":"2025-06-27 20:51:28","resources":{"nodes":[{"site":"LIVECHART","externalId":4660},{"site":"ANILIST","externalId":279},{"site":"MAL","externalId":279},{"site":"ANIDB","externalId":1001},{"site":"ANIME_PLANET","externalId":null},{"site":"ANN","externalId":2765},{"site":"KITSU","externalId":254}]},"images":{"nodes":[{"id":12738,"facet":"SMALL_COVER","path":"anime/small-cover/7P5Li8yFZHMFSDlq7g7VsBv3lTK45Z0iAqc1DMof.avif"},{"id":12739,"facet":"LARGE_COVER","path":"anime/large-cover/HcfiJJgzPKbkj6KEkHcv67xJ7GNzyo9wKEyuXqOn.jpg"}]},"studios":{"nodes":[{"id":40,"name":"TMS Entertainment","slug":"tms_entertainment"}]},"series":{"nodes":[]},"animethemes":[{"id":13727,"slug":"OP1","type":"OP","sequence":null,"song":{"id":13645,"title":"The Flame","titleNative":null},"animethemeentries":[{"id":16109,"version":1,"episodes":"1-13","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":18914,"basename":"KyougokuNatsuhikoKousetsuHyakuMonogatari-OP1.webm","filename":"KyougokuNatsuhikoKousetsuHyakuMonogatari-OP1","link":"https://v.animethemes.moe/KyougokuNatsuhikoKousetsuHyakuMonogatari-OP1.webm","mimetype":"video/webm","size":52733282,"resolution":1080,"nc":false,"subbed":false,"lyri