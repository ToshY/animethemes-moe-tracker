{"id":4553,"name":"Shiunji-ke no Kodomotachi","slug":"shiunji_ke_no_kodomotachi","synopsis":"The love between brother and sister. The love between man and woman. That which is most forbidden is most unyielding. The two sons and five daughters of the Shiunji family shine like brilliant gems, each with intelligence and beauty in equal measure. And with the pedigree of their wealthy father behind them, how could they not be the talk of the town? Eldest son Arata has spent his life being tossed around by the whims of his colorful sisters, yet a little teasing won't stop him from valuing his family over anything and anyone else. But when his youngest sister turns fifteen, their father reveals a long-hidden secret of the Shiunji \"siblings\" and knocks Arata's world off its axis...\n\n(Source: Yen Press)","format":"TV","season":"SPRING","year":2025,"createdAt":"2025-04-09 02:45:48","updatedAt":"2025-04-15 17:08:07","resources":{"nodes":[{"site":"LIVECHART","externalId":12532},{"site":"ANIDB","externalId":18496},{"site":"ANILIST","externalId":174802},{"site":"ANIME_PLANET","externalId":null},{"site":"ANN","externalId":32099},{"site":"KITSU","externalId":48544},{"site":"MAL","externalId":58131},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":12600,"facet":"SMALL_COVER","path":"anime/small-cover/5PmvpvtcBV2Q19yEYbxLjSA3eH6FVObawDooK9sj.avif"},{"id":12601,"facet":"LARGE_COVER","path":"anime/large-cover/S0oAu0fQFkHLw15Itv4gZgKdcUVRHeGpFiHulIa8.jpg"}]},"studios":{"nodes":[{"id":4,"name":"Doga Kobo","slug":"doga_kobo"}]},"series":{"nodes":[]},"animethemes":[{"id":13617,"slug":"OP1","type":"OP","sequence":null,"song":{"id":13540,"title":"Honey Lemon","titleNative":null},"animethemeentries":[{"id":15927,"version":1,"episodes":"1-12","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":18723,"basename":"ShiunjiKeNoKodomotachi-OP1.webm","filename":"ShiunjiKeNoKodomotachi-OP1","link":"https