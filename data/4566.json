{"id":4566,"title":{"romaji":"Ninja to Koroshiya no Futarigurashi","english":"A Ninja and an Assassin Under One Roof","native":"忍者と殺し屋のふたりぐらし"},"slug":"ninja_to_koroshiya_no_futarigurashi","synopsis":"Satoko Kusagakure, a female ninja who left her village with her comrades, finds herself living with Konoha, a high school girl working as an assassin in the city. Satoko possesses the ability to transform objects using ninjutsu, which catches Konoha's attention. They strike a deal: Konoha provides Satoko with a place to live in exchange for Satoko's help in cleaning up after her assassination jobs.\n\nAs they face off against assassins sent by Satoko's village, indulge in delicious meals using money earned from assassination jobs, and navigate the chaos of their unusual living situation, the story captures the heartwarming yet chaotic lives of these two unlikely roommates.","format":"TV","season":"SPRING","year":2025,"createdAt":"2025-04-16 23:55:14","updatedAt":"2025-04-16 23:55:14","resources":{"nodes":[{"site":"LIVECHART","externalId":12641},{"site":"ANIDB","externalId":18596},{"site":"ANILIST","externalId":177120},{"site":"ANIME_PLANET","externalId":null},{"site":"KITSU","externalId":48839},{"site":"MAL","externalId":58725},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null},{"site":"ANN","externalId":32690}]},"images":{"nodes":[{"id":12627,"facet":"SMALL_COVER","path":"anime/small-cover/wGdxULvOoJg4x2TVVBs5G8AtupdE9we8tFf55VAG.avif"},{"id":12628,"facet":"LARGE_COVER","path":"anime/large-cover/GWu4dgtrBL8MRQu00TbWqwBjPoso5z4UjCgk1MqJ.png"}]},"studios":{"nodes":[{"id":11,"name":"Shaft","slug":"shaft"}]},"series":{"nodes":[]},"animethemes":[{"id":13645,"slug":"OP1","type":"OP","sequence":null,"song":{"id":13568,"title":{"romaji":"Yarenno? Endless","native":null}},"animethemeentries":[{"id":15955,"version":1,"episodes":"1-4, 6-11","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":18751,"basename":"NinK