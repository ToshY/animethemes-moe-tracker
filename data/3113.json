{"id":3113,"name":"Wakaba*Girl","slug":"wakabagirl","synopsis":"The manga's story centers around the activities of Wakaba Kohashi, \"a slightly out-of-tune super\" daughter of a well-to-do family, and her friends. Wakaba (literally, \"young leaves\") looks like an elegant rich daughter, but she admires the trendy \"gyaru\" fashion subculture. There is also the pure, innocent, fairy-tale-like Moeko. Mao is capricious and behaves in her own way. Nao used to be an athletic type of girl, but now loves the boys-love genre.\n\n\n(Source: Anime News Network)","format":"TV_SHORT","season":"SUMMER","year":2015,"createdAt":"2021-03-27 00:44:47","updatedAt":"2021-03-28 09:20:57","resources":{"nodes":[{"site":"MAL","externalId":30355},{"site":"ANILIST","externalId":21108},{"site":"KITSU","externalId":10767},{"site":"ANIDB","externalId":11139},{"site":"ANN","externalId":16870},{"site":"ANIME_PLANET","externalId":7117},{"site":"OFFICIAL_SITE","externalId":null},{"site":"CRUNCHYROLL","externalId":null},{"site":"HULU","externalId":null},{"site":"X","externalId":null},{"site":"HIDIVE","externalId":null}]},"images":{"nodes":[{"id":6211,"facet":"LARGE_COVER","path":"anime/large-cover/cfhJHnuRvadJLf7iiBLQLUWSNx4g1wGTlWXpCiP5.jpg"},{"id":6212,"facet":"SMALL_COVER","path":"anime/small-cover/l0yUy9WUJhmWCjdBUWMshmVxFbGu5u0YSTNpWQYZ.avif"}]},"studios":{"nodes":[{"id":145,"name":"Nexus","slug":"nexus"}]},"series":{"nodes":[]},"animethemes":[{"id":6274,"slug":"OP1","type":"OP","sequence":1,"song":{"id":6274,"title":"Hajimete Girls!","titleNative":null},"animethemeentries":[{"id":7292,"version":1,"episodes":"1-8, 10-12","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":6442,"basename":"WakabaGirl-OP1.webm","filename":"WakabaGirl-OP1","link":"https://v.animethemes.moe/WakabaGirl-OP1.webm","mimetype":"video/webm","size":59499329,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":5606,"basename":"WakabaGirl-OP1.ogg","filen