{"id":830,"name":"Gakuen Babysitters","slug":"gakuen_babysitters","synopsis":"The manga centers on the brothers Ryuuichi and Kotarou Kashima. Ryuuichi is in high school and Kotarou is still a toddler. After their parents are killed in a plane crash, the two brothers find themselves living with the chairwoman of the Morinomiya Academy, who herself lost her son and daughter-in-law in the same accident. The chairwoman, however, has one stipulation for the brothers in order to live with her: Ryuuichi has to work at the academy's daycare center as a babysitter.\n\n\n(Source: Anime News Network)","format":"TV","season":"WINTER","year":2018,"createdAt":"2021-03-27 00:43:46","updatedAt":"2021-03-28 02:08:32","resources":{"nodes":[{"site":"MAL","externalId":35222},{"site":"ANILIST","externalId":98503},{"site":"KITSU","externalId":13265},{"site":"ANIDB","externalId":13023},{"site":"ANN","externalId":19400},{"site":"ANIME_PLANET","externalId":8640},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":1655,"facet":"LARGE_COVER","path":"anime/large-cover/JqQKeF3ctATEC5FQU4UzaMUAPS03Rc9LzOHjsSdy.jpg"},{"id":1656,"facet":"SMALL_COVER","path":"anime/small-cover/vyZ9DBhJtr26P7KmyNWgydHsde6OY79ZpOiyoakv.avif"}]},"studios":{"nodes":[{"id":58,"name":"Brain's Base","slug":"brains_base"}]},"series":{"nodes":[]},"animethemes":[{"id":8583,"slug":"OP1","type":"OP","sequence":null,"song":{"id":8584,"title":"Endless happy world","titleNative":null},"animethemeentries":[{"id":10045,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":9844,"basename":"GakuenBabysitters-OP1.webm","filename":"GakuenBabysitters-OP1","link":"https://v.animethemes.moe/GakuenBabysitters-OP1.webm","mimetype":"video/webm","size":27861458,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"RAW","tags":"","audio":{"id":7768,"basename":"GakuenBabysitters-OP1.ogg","filename"