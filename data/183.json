{"id":183,"name":"Ashita no Joe","slug":"ashita_no_joe","synopsis":"Joe, a teenage orphan in the slums of the Doya streets, meets Danpei, a homeless, alcoholic ex-boxing coach. Danpei, seeing Joe's boxing talent, decides to train him. When Joe is sent to a terrible juvenile home for petty crimes, he meets Rikiishi who becomes his boxing rival. Danpei arrives at the home to help Joe to train in order to defeat Rikiishi. When Joe decides to seriously pursue boxing, Danpei cannot get a coaching license because of his reputation as a drunk. \n\n(Source: AnimeNfo)","format":"TV","season":"SPRING","year":1970,"createdAt":"2021-03-27 00:43:30","updatedAt":"2021-03-28 00:13:29","resources":{"nodes":[{"site":"MAL","externalId":2402},{"site":"ANILIST","externalId":2402},{"site":"KITSU","externalId":2178},{"site":"ANIDB","externalId":1457},{"site":"ANN","externalId":456},{"site":"ANIME_PLANET","externalId":1357}]},"images":{"nodes":[{"id":365,"facet":"LARGE_COVER","path":"anime/large-cover/uwKSbKeLOo1zgpnvNfvXD8tEAXKyi1AEIsRsjv0d.jpg"},{"id":366,"facet":"SMALL_COVER","path":"anime/small-cover/zT30RZjg9XU2lQTyG1I6nkKm2ZVL1oSp5FsJRPEV.avif"}]},"studios":{"nodes":[{"id":77,"name":"Mushi Production","slug":"mushi_production"}]},"series":{"nodes":[{"id":607,"name":"Ashita no Joe","slug":"ashita_no_joe"}]},"animethemes":[{"id":44,"slug":"OP1","type":"OP","sequence":null,"song":{"id":44,"title":"Ashita no Joe","titleNative":null},"animethemeentries":[{"id":47,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":12325,"basename":"AshitaNoJoe-OP1.webm","filename":"AshitaNoJoe-OP1","link":"https://v.animethemes.moe/AshitaNoJoe-OP1.webm","mimetype":"video/webm","size":14466194,"resolution":480,"nc":false,"subbed":false,"lyrics":true,"overlap":"NONE","source":"DVD","tags":"DVD480Lyrics","audio":{"id":10205,"basename":"AshitaNoJoe-OP1.ogg","filename":"AshitaNoJoe-OP1","link":"https://a.animethemes.moe/AshitaNoJoe-OP1.ogg","mimetype":"audio/ogg","size":1820005}}