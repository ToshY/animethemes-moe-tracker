{"id":3898,"name":"Yama no Susume: Next Summit","slug":"yama_no_susume_next_summit","synopsis":"Aoi Yukimura’s fear of heights won’t hold her back in the next adaptation of Encouragement of Climb! Joined by fellow mountaineering enthusiasts, including the spirited Hinata Kuraue and the other climbers they’ve met on their journey to great heights, Aoi and friends tackle tough challenges and conquer new summits while they embark on adventures throughout the mountain ranges of Japan. Fans new to the franchise will get to know the world of Encouragement of Climb via a selection of compilation episodes that reintroduce fan-favorite characters and beloved moments from the series. Later episodes contain all-new stories that continue the tale of Aoi and her ambition to overcome her fears and achieve her dreams.","format":"TV","season":"FALL","year":2022,"createdAt":"2022-10-04 15:09:54","updatedAt":"2022-10-04 15:09:54","resources":{"nodes":[{"site":"MAL","externalId":48491},{"site":"KITSU","externalId":44193},{"site":"ANILIST","externalId":131182},{"site":"ANIDB","externalId":16138},{"site":"ANIME_PLANET","externalId":16499},{"site":"ANN","externalId":24161},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"HIDIVE","externalId":null}]},"images":{"nodes":[{"id":10065,"facet":"LARGE_COVER","path":"anime/large-cover/IkZdi0R5cXQ1KlMQngDTRl9g5Bd0k0cV4Vy844YO.jpg"},{"id":10066,"facet":"SMALL_COVER","path":"anime/small-cover/YqWxXdU9oGmHrEJQgCvpxcPdsi1ngPZ4xOuLebeV.avif"}]},"studios":{"nodes":[{"id":24,"name":"8bit","slug":"8bit"}]},"series":{"nodes":[{"id":183,"name":"Yama no Susume","slug":"yama_no_susume"}]},"animethemes":[{"id":11803,"slug":"OP1","type":"OP","sequence":null,"song":{"id":11800,"title":"Omoi Nochi Hare","titleNative":null},"animethemeentries":[{"id":13732,"version":1,"episodes":"1-11","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":16026,"basename":"YamaNoSusumeS4-OP1.webm","filename":"YamaNoSusumeS4-OP1","link":"https://v