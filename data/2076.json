{"id":2076,"title":{"romaji":"Ninpuu Kamui Gaiden","english":null,"native":null},"slug":"ninpuu_kamui_gaiden","synopsis":"Kamui is a ninja from the Edo period who has decided to leave his clan. After doing so he is pursued relentlessly by the members of his former clan; who consider him to be a traitor and therefore wish to kill him. Kamui then wanders around Japan to escape from them by using his intelligence and great abilities to survive. In the course of the series Kamui begins to suffer from paranoia because of his status as a persecuted man. Kamui then started to believe that everybody wished to murder him and became distrusting of everyone he came across.\n\n(Source: Wikipedia)","format":"TV","season":"SPRING","year":1969,"createdAt":"2021-03-27 00:44:20","updatedAt":"2021-03-28 05:55:31","resources":{"nodes":[{"site":"MAL","externalId":5023},{"site":"ANILIST","externalId":5023},{"site":"KITSU","externalId":3888},{"site":"ANIDB","externalId":2866},{"site":"ANN","externalId":2375},{"site":"ANIME_PLANET","externalId":4076},{"site":"OFFICIAL_SITE","externalId":null}]},"images":{"nodes":[{"id":4143,"facet":"LARGE_COVER","path":"anime/large-cover/Jw4Lq34aHNppCbiT7nMUxKWb9SvrNSCWED6gONdl.jpg"},{"id":4144,"facet":"SMALL_COVER","path":"anime/small-cover/HFKDQGgrAGd7nlQKEF7yhwwWNGK9ca5DhmtJJcHA.avif"}]},"studios":{"nodes":[{"id":272,"name":"Tele-Cartoon Japan","slug":"tele_cartoon_japan"}]},"series":{"nodes":[]},"animethemes":[{"id":20,"slug":"OP1","type":"OP","sequence":null,"song":{"id":20,"title":{"romaji":"Shinobi no Theme (Instrumental)","native":null}},"animethemeentries":[{"id":21,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":12297,"basename":"NinpuuKamuiGaiden-OP1.webm","filename":"NinpuuKamuiGaiden-OP1","link":"https://v.animethemes.moe/NinpuuKamuiGaiden-OP1.webm","mimetype":"video/webm","size":44215948,"resolution":1080,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"BD1080","audio":{"id":24