{"id":4855,"title":{"romaji":"Tadaima, Ojamasaremasu!","english":"Pardon the Intrusion, I'm Home!","native":"ただいま、おじゃまされます！"},"slug":"tadaima_ojamasaremasu","synopsis":"So is this what it means to have roommates now?! Office worker Rinko, 24, lives alone and is secretly an otaku. One day, her apartment gets connected to the two neighboring rooms through a \"hole\" in the wall. In the room on the left is a fresh-faced yet mysterious guy who is overly-sweet to Rinko. The room on the right is occupied by a guy with violent tendences who is similarly mysterious... But wait! \"I... I think I know him!\" Rinko's only source of solitude, her apartment, has been turned upside down. Now, every day is full of heart-pounding surprises!\n\n(Source: Manga Plaza)","format":"TV","season":"SPRING","year":2026,"createdAt":"2026-06-26 21:25:36","updatedAt":"2026-06-26 21:25:36","resources":{"nodes":[{"site":"ANILIST","externalId":202985},{"site":"ANIME_PLANET","externalId":27208},{"site":"ANIDB","externalId":19736},{"site":"KITSU","externalId":50643},{"site":"LIVECHART","externalId":13402},{"site":"MAL","externalId":63014},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null},{"site":"ANN","externalId":38055}]},"images":{"nodes":[{"id":13371,"facet":"SMALL_COVER","path":"anime/small-cover/VVQlPxO2MHlUQxgLF7Q9XtsRyS965aVfxULUIGj9.avif"},{"id":13372,"facet":"LARGE_COVER","path":"anime/large-cover/RIDMLvUZy45Xuk1pcRjQI3r8PPgHlYVAT9wO69AP.jpg"}]},"studios":{"nodes":[{"id":47,"name":"Tatsunoko Production","slug":"tatsunoko_production"}]},"series":{"nodes":[]},"animethemes":[{"id":14452,"slug":"OP1","type":"OP","sequence":null,"song":{"id":14353,"title":{"romaji":"C'est la vie","native":"C'est la vie"}},"animethemeentries":[{"id":16903,"version":1,"episodes":"1-","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":19660,"basename":"TadaimaOjamasaremasu-OP1.webm","filename":"TadaimaOjamasaremasu-OP1","link":"https://v.animetheme