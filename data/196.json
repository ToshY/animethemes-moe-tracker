{"id":196,"name":"Atom: The Beginning","slug":"atom_the_beginning","synopsis":"With no investor funding, Umatarou Tenma and Hiroshi Ochanomizu must turn to odd jobs to fund their project: to build a humanoid robot that thinks and feels like a human being. When the two geniuses succeed in building A106, they start experimenting with his emotional capabilities right away. As they test to see if they truly can build a sentient robot, one question remains: will this robot become a god or a friend?\n\n(Source: Sentai Filmworks)","format":"TV","season":"SPRING","year":2017,"createdAt":"2021-03-27 00:43:30","updatedAt":"2021-03-28 00:16:04","resources":{"nodes":[{"site":"MAL","externalId":33371},{"site":"ANILIST","externalId":21830},{"site":"KITSU","externalId":12235},{"site":"ANIDB","externalId":12148},{"site":"ANN","externalId":18989},{"site":"ANIME_PLANET","externalId":7935},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"AMAZON_PRIME_VIDEO","externalId":null}]},"images":{"nodes":[{"id":391,"facet":"LARGE_COVER","path":"anime/large-cover/VuWT4zLU8q9qjzMLPlE2iB8SfU2XklC1csv7IMWL.png"},{"id":392,"facet":"SMALL_COVER","path":"anime/small-cover/CZ8inDKO6FBsdAihZ8dREtxriBoG6LuNnur6yHen.avif"}]},"studios":{"nodes":[{"id":5,"name":"OLM","slug":"olm"},{"id":65,"name":"Production I.G","slug":"production_ig"},{"id":79,"name":"Signal.MD","slug":"signalmd"}]},"series":{"nodes":[{"id":496,"name":"Tetsuwan Atom","slug":"tetsuwan_atom"}]},"animethemes":[{"id":7631,"slug":"OP1","type":"OP","sequence":null,"song":{"id":7632,"title":"Kaidoku Funou","titleNative":null},"animethemeentries":[{"id":8943,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":7954,"basename":"AtomTheBeginning-OP1.webm","filename":"AtomTheBeginning-OP1","link":"https://v.animethemes.moe/AtomTheBeginning-OP1.webm","mimetype":"video/webm","size":24059478,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags":""