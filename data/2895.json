{"id":2895,"title":{"romaji":"Tenki no Ko","english":"Weathering With You","native":"天気の子"},"slug":"tenki_no_ko","synopsis":"High school student Hodaka leaves his home on an isolated island and moves to Tokyo, but he immediately becomes broke. He lives his days in isolation, but finally finds a job as a writer for a shady occult magazine. After he starts his job, the weather has been rainy day after day. In a corner of the crowded and busy city, Hodaka meets a young woman named Hina. Due to certain circumstances, Hina and her younger brother live together, but have a cheerful and sturdy life. Hina also has a certain power: the power to stop the rain and clear the sky.\n\n\n(Source: Anime News Network)","format":"MOVIE","season":"SUMMER","year":2019,"createdAt":"2021-03-27 00:44:42","updatedAt":"2021-03-28 08:40:55","resources":{"nodes":[{"site":"MAL","externalId":38826},{"site":"ANILIST","externalId":106286},{"site":"KITSU","externalId":42028},{"site":"ANIDB","externalId":14534},{"site":"ANN","externalId":22137},{"site":"ANIME_PLANET","externalId":12591},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"NETFLIX","externalId":81172898},{"site":"AMAZON_PRIME_VIDEO","externalId":null}]},"images":{"nodes":[{"id":5775,"facet":"LARGE_COVER","path":"anime/large-cover/MuNh5ysxl5Dodp8kColf3cMIp73r0aRCikl0aHuj.png"},{"id":5776,"facet":"SMALL_COVER","path":"anime/small-cover/Jy0HHvKsVVMHdZJt4l57Pmt80Wm4wVD8OEcuzSyC.avif"}]},"studios":{"nodes":[{"id":122,"name":"CoMix Wave Films","slug":"comix_wave_films"}]},"series":{"nodes":[]},"animethemes":[{"id":9042,"slug":"ED1","type":"ED","sequence":1,"song":{"id":9043,"title":{"romaji":"Daijoubu (Movie edit)","native":null}},"animethemeentries":[{"id":10627,"version":1,"episodes":null,"nsfw":false,"spoiler":true,"videos":{"nodes":[{"id":10975,"basename":"TenkiNoKo-ED1.webm","filename":"TenkiNoKo-ED1","link":"https://v.animethemes.moe/TenkiNoKo-ED1.webm","mimetype":"video/webm","size":63948085,"resolutio