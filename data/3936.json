{"id":3936,"name":"Blue Thermal","slug":"blue_thermal","synopsis":"Tamaki Tsuru, a freshman at Aonagi University, was overzealous about volleyball when she was in high school. Following a romantic rejection due to being an athletic girl, she joined the tennis club in college to be less athletic. One day, she accidentally hits Daisuke with a tennis ball as he was transporting a glider, causing damage to it. Tamaki was charged with a repair cost of two million yen, but as she couldn't pay the amount, she joins the sports association aviation club as a helper.\r\n\r\n(Source: MAL News)","format":"MOVIE","season":"WINTER","year":2022,"createdAt":"2022-11-25 04:45:16","updatedAt":"2022-11-25 04:45:16","resources":{"nodes":[{"site":"MAL","externalId":49665},{"site":"KITSU","externalId":45024},{"site":"ANILIST","externalId":138379},{"site":"ANIDB","externalId":16552},{"site":"ANN","externalId":24663},{"site":"ANIME_PLANET","externalId":17737},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null}]},"images":{"nodes":[{"id":10271,"facet":"LARGE_COVER","path":"anime/large-cover/0eKvwrC6dxCopsyArDQJjotQkSVdl9VQRfJBOPGh.jpg"},{"id":10272,"facet":"SMALL_COVER","path":"anime/small-cover/eT0vlbsAu1K7posbIKuS4rldfoJQ6Fm2etCZOW7O.avif"}]},"studios":{"nodes":[{"id":126,"name":"Telecom Animation Film","slug":"telecom_animation_film"}]},"series":{"nodes":[]},"animethemes":[{"id":11932,"slug":"ED1","type":"ED","sequence":null,"song":{"id":11926,"title":"Blue Thermal","titleNative":null},"animethemeentries":[{"id":13904,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":16194,"basename":"BlueThermal-ED1.webm","filename":"BlueThermal-ED1","link":"https://v.animethemes.moe/BlueThermal-ED1.webm","mimetype":"video/webm","size":27245889,"resolution":1080,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"BD1080","audio":{"id":11762,"basename":"BlueThermal-ED1.ogg","filename":"BlueThermal-ED1","link":"https://a.ani