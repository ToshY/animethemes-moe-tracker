{"id":643,"name":"Dororo","slug":"dororo","synopsis":"Dororo, a young orphan thief, meets Hyakkimaru, a powerful ronin. Hyakkimaru's father, a greedy feudal lord, had made a pact with 12 demons, offering his yet-unborn son's body parts in exchange for great power. Thus, Hyakkimaru - who was born without arms, legs, eyes, ears, a nose or a mouth - was abandoned in a river as a baby. Rescued and raised by Dr. Honma, who equips him with artificial limbs and teaches him sword-fighting techniques, Hyakkimaru discovers that each time he slays a demon, a piece of his body is restored. Now, he roams the war-torn countryside in search of demons.","format":"TV","season":"WINTER","year":2019,"createdAt":"2021-03-27 00:43:41","updatedAt":"2021-03-28 01:35:06","resources":{"nodes":[{"site":"MAL","externalId":37520},{"site":"ANILIST","externalId":101347},{"site":"KITSU","externalId":41083},{"site":"ANIDB","externalId":13946},{"site":"ANN","externalId":20779},{"site":"ANIME_PLANET","externalId":9859},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"AMAZON_PRIME_VIDEO","externalId":null},{"site":"HIDIVE","externalId":null}]},"images":{"nodes":[{"id":1281,"facet":"LARGE_COVER","path":"anime/large-cover/F9UFDQG2TV0Ln2ljyHVtjARHum5NfpvGOu9qXYyz.jpg"},{"id":1282,"facet":"SMALL_COVER","path":"anime/small-cover/KcRYe3jajQkP2k8jBGINKumrt1GBVzE7hY6PDjT7.avif"}]},"studios":{"nodes":[{"id":31,"name":"Tezuka Productions","slug":"tezuka_productions"},{"id":89,"name":"MAPPA","slug":"mappa"}]},"series":{"nodes":[{"id":624,"name":"Dororo","slug":"dororo"}]},"animethemes":[{"id":9281,"slug":"OP1","type":"OP","sequence":1,"song":{"id":9282,"title":"Kaen","titleNative":null},"animethemeentries":[{"id":10907,"version":1,"episodes":"1-12","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":11074,"basename":"Dororo2019-OP1-NCBD1080.webm","filename":"Dororo2019-OP1-NCBD1080","link":"https://v.animethemes.moe/Dororo2019-OP1-NCBD1080.webm","mimetype":"video/webm","size"