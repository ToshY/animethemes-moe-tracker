{"id":1825,"title":{"romaji":"Makai Senki Disgaea","english":"Netherworld Battle Chronicle: Disgaea","native":"魔界戦記ディスガイア"},"slug":"makai_senki_disgaea","synopsis":"From the darkest realms of another dimension emerges the story of Laharl, the son of a demon overlord, and his two sidekicks: his impish servant and an angelic assassin. Awoken from a two-year, poison-induced nap, Laharl learns of his father&rsquo;s demise and blazes a trail of destruction on his quest to declare rule over the Netherworld. Never skimping on the wisecracks, the diabolical prince and his accomplices battle dragons, sorceresses, robots, power-hungry humans, and corrupt angels.\n\nBased on the popular adventure games, Disgaea lunges at you with a full-force attack. You can laugh, cry, scream or squirm, but you can&rsquo;t escape the wrath of Laharl, dood!\n\n(Source: FUNimation Entertainment)","format":"TV","season":"SPRING","year":2006,"createdAt":"2021-03-27 00:44:13","updatedAt":"2021-03-28 05:10:48","resources":{"nodes":[{"site":"MAL","externalId":860},{"site":"ANILIST","externalId":860},{"site":"KITSU","externalId":762},{"site":"ANIDB","externalId":3444},{"site":"ANN","externalId":6094},{"site":"ANIME_PLANET","externalId":1388},{"site":"HULU","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":3641,"facet":"LARGE_COVER","path":"anime/large-cover/kPSo4JsBO3kx3GBbv7bEMZ8MqbcQsnWAO9Uy9RES.png"},{"id":3642,"facet":"SMALL_COVER","path":"anime/small-cover/Cqp3paTMXJJzjri89EX9uiwZXfNVByQoUB1n6iuc.avif"}]},"studios":{"nodes":[{"id":5,"name":"OLM","slug":"olm"}]},"series":{"nodes":[]},"animethemes":[{"id":2490,"slug":"OP1","type":"OP","sequence":null,"song":{"id":2490,"title":{"romaji":"Aishitageru","native":null}},"animethemeentries":[{"id":2804,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":1509,"basename":"MakaiSenkiDisgaea-OP1.webm","filename":"MakaiSenkiDisgaea-OP1","link":"https://v.animethemes.moe/MakaiSenkiDisgaea-OP1.