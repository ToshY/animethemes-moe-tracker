{"id":2477,"name":"Sanrio Danshi","slug":"sanrio_danshi","synopsis":"The project's premise follows Kouta Hasegawa, a high school boy that loves the yellow Pom Pom Purin dog. By mere coincidence, he ends up attending the same school as Yuu Mizuno, a boy who likes the bunny My Melody. Yuu tells Kouta that there's nothing to be ashamed of for liking Sanrio's cute characters. Together, Kouta, Yuu, Shunsuke Yoshino, Ryou Nishimiya, and Seiichiro Minamoto learn to accept their love of the characters instead of feeling embarrassed.\n\n\n(Source: Anime News Network)","format":"TV","season":"WINTER","year":2018,"createdAt":"2021-03-27 00:44:31","updatedAt":"2021-03-28 07:25:03","resources":{"nodes":[{"site":"MAL","externalId":34839},{"site":"ANILIST","externalId":98217},{"site":"KITSU","externalId":13714},{"site":"ANIDB","externalId":12781},{"site":"ANN","externalId":20015},{"site":"ANIME_PLANET","externalId":8507},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":4941,"facet":"LARGE_COVER","path":"anime/large-cover/2b6mMrUYIcdOjxgk47ZgkXYTfolet7tD2xAMLn8z.jpg"},{"id":4942,"facet":"SMALL_COVER","path":"anime/small-cover/lr5btAT03M9Fk53LoBKs9kZAWlsoJY7zFqttkvQR.avif"}]},"studios":{"nodes":[{"id":44,"name":"Pierrot","slug":"pierrot"}]},"series":{"nodes":[]},"animethemes":[{"id":8691,"slug":"OP1","type":"OP","sequence":null,"song":{"id":8692,"title":"Seishun Interlude","titleNative":null},"animethemeentries":[{"id":10206,"version":1,"episodes":"3-11","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":10055,"basename":"SanrioDanshi-OP1.webm","filename":"SanrioDanshi-OP1","link":"https://v.animethemes.moe/SanrioDanshi-OP1.webm","mimetype":"video/webm","size":28388993,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags":"","audio":{"id":7866,"basename":"SanrioDanshi-OP1.ogg","filename":"SanrioDanshi-OP1","link":"https://a.animethemes.moe/Sanrio