{"id":343,"name":"Bokurano","slug":"bokurano","synopsis":"During a summer camp, 15 children, 8 males and 7 females, find a grotto by the sea. Deep within they discover working computers and some electronic equipment, and later the owner, a man called Kokopelli. Kokopelli claimed to be a programmer working on a brand new game, in which a large robot has to defend the Earth against alien invasions. He persuades the children to test the game and sign a contract. All but one of them signs, barely a moment later they mysteriously awaken on the shore believing what happened was just a dream.\n\n(Source: Anime News Network)","format":"TV","season":"SPRING","year":2007,"createdAt":"2021-03-27 00:43:34","updatedAt":"2021-03-28 00:41:54","resources":{"nodes":[{"site":"MAL","externalId":1690},{"site":"ANILIST","externalId":1690},{"site":"KITSU","externalId":1518},{"site":"ANIDB","externalId":4861},{"site":"ANN","externalId":7213},{"site":"ANIME_PLANET","externalId":1154},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":685,"facet":"LARGE_COVER","path":"anime/large-cover/NxT1FpSCSfqL0T9lR3g0GtxDjREHqPes1EjzFilx.jpg"},{"id":686,"facet":"SMALL_COVER","path":"anime/small-cover/Zo8LiPa7wc11yuDBoSkGApC96kWvlz9Zz41cel0I.avif"}]},"studios":{"nodes":[{"id":6,"name":"Gonzo","slug":"gonzo"}]},"series":{"nodes":[]},"animethemes":[{"id":2743,"slug":"OP1","type":"OP","sequence":null,"song":{"id":2743,"title":"Uninstall","titleNative":null},"animethemeentries":[{"id":3077,"version":1,"episodes":"1-24","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":1779,"basename":"Bokurano-OP1.webm","filename":"Bokurano-OP1","link":"https://v.animethemes.moe/Bokurano-OP1.webm","mimetype":"video/webm","size":54485546,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":1703,"basename":"Bokurano-OP1.ogg","filename":"Bokurano-OP1","link":"https://a.animethemes.moe/Bokurano-OP1.ogg","mimetype":"audio/ogg","size":3619755