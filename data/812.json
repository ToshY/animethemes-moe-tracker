{"id":812,"name":"Futatsu no Spica","slug":"futatsu_no_spica","synopsis":"When Kamogawa Asumi was just a baby, her mother was grievously injured when a rocket crashed to the ground. Five years later, having been in a coma all the time, Asumi's mother finally dies, and the little girl struggles to come to terms with the death of a mother she barely remembers. In the midst of her turmoil, she meets \"Lion-san\", a strange figure wearing a lion mask and claiming to be a ghost. Lion-san helps Asumi to bury her mother's ashes, and finally, Asumi reaches her own decision: \"When I grow up, I'm going to be a rocket pilot.\"\n\n\n(Source: Anime News Network)","format":"TV","season":"FALL","year":2003,"createdAt":"2021-03-27 00:43:45","updatedAt":"2021-03-28 02:05:24","resources":{"nodes":[{"site":"MAL","externalId":344},{"site":"ANILIST","externalId":344},{"site":"KITSU","externalId":311},{"site":"ANIDB","externalId":1139},{"site":"ANN","externalId":3084},{"site":"ANIME_PLANET","externalId":476}]},"images":{"nodes":[{"id":1619,"facet":"LARGE_COVER","path":"anime/large-cover/guO957QyzZclK69QtBgbvzxWQVQTVV6nfsCkKnMk.jpg"},{"id":1620,"facet":"SMALL_COVER","path":"anime/small-cover/TWbeQHCtxxU61eIwHV2EEzldkYuSiG9JpO4niYt3.avif"}]},"studios":{"nodes":[{"id":10,"name":"Group TAC","slug":"group_tac"}]},"series":{"nodes":[]},"animethemes":[{"id":1661,"slug":"OP1","type":"OP","sequence":null,"song":{"id":1661,"title":"Venus Say","titleNative":null},"animethemeentries":[{"id":1834,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":540,"basename":"FutatsuNoSpica-OP1.webm","filename":"FutatsuNoSpica-OP1","link":"https://v.animethemes.moe/FutatsuNoSpica-OP1.webm","mimetype":"video/webm","size":37251807,"resolution":480,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"DVD","tags":"NCDVD480","audio":{"id":570,"basename":"FutatsuNoSpica-OP1.ogg","filename":"FutatsuNoSpica-OP1","link":"https://a.animethemes.moe/FutatsuNoSpica-OP1.ogg","mimety