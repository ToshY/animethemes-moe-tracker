{"id":4322,"title":{"romaji":"Pon no Michi","english":"The Way of Pon","native":"ぽんのみち"},"slug":"pon_no_michi","synopsis":"The anime is set in Hiroshima Prefecture's Onomichi City, where a high school student Nashiko Jippensha was kicked out of her house. Without a place to play with her friends, she learns that the mahjong parlor that her father used to run is now vacant. She fixes the mahjong parlor and turns it into a place where she and her friends can have fun, cook, have tea, and sometimes play mahjong.\n\n(Source: Anime News Network)","format":"TV","season":"WINTER","year":2024,"createdAt":"2024-06-16 07:12:18","updatedAt":"2024-06-16 07:12:18","resources":{"nodes":[{"site":"ANILIST","externalId":165314},{"site":"KITSU","externalId":47483},{"site":"MAL","externalId":55397},{"site":"ANIDB","externalId":18043},{"site":"X","externalId":null},{"site":"OFFICIAL_SITE","externalId":null},{"site":"NETFLIX","externalId":81748107},{"site":"HULU","externalId":null},{"site":"ANIME_PLANET","externalId":23496},{"site":"ANN","externalId":28336},{"site":"YOUTUBE","externalId":null}]},"images":{"nodes":[{"id":11870,"facet":"LARGE_COVER","path":"anime/large-cover/ZyecxX9X5rVjFbyFDS3Lgh4Ut1kbAoeGZJk7IGsO.jpg"},{"id":11871,"facet":"SMALL_COVER","path":"anime/small-cover/6Q3RcBGmGzQfRjWdSjufhyfObZPGMbBhuQrnkaoV.avif"}]},"studios":{"nodes":[{"id":5,"name":"OLM","slug":"olm"}]},"series":{"nodes":[]},"animethemes":[{"id":12952,"slug":"OP1","type":"OP","sequence":null,"song":{"id":12902,"title":{"romaji":"Ponpopopon","native":null}},"animethemeentries":[{"id":15152,"version":1,"episodes":"1-12","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":17865,"basename":"PonNoMichi-OP1.webm","filename":"PonNoMichi-OP1","link":"https://v.animethemes.moe/PonNoMichi-OP1.webm","mimetype":"video/webm","size":62764025,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":13229,"basename":"PonNoMichi-OP1.ogg","filename":"PonNoMich