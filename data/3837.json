{"id":3837,"name":"Isekai Ojisan","slug":"isekai_ojisan","synopsis":"Seventeen years ago, Takafumi's uncle fell into a coma, but now he's back like a man risen from his grave. Soon, Takafumi discovers two bizarre things: His uncle treasures video games above all else, and, while comatose, he was actually transported to another world as some heroic guardian! Now, not only does Takafumi have to room with an uncle who is literally magical, he also has to catch the guy up on two decades of history—smartphones, high-speed internet, modern anime tropes...and the traumatic outcome of the '90s console war!\r\n\r\n(Source: Yen Press)","format":"TV","season":"SUMMER","year":2022,"createdAt":"2022-07-06 06:03:26","updatedAt":"2022-07-06 06:03:26","resources":{"nodes":[{"site":"MAL","externalId":49220},{"site":"ANILIST","externalId":135806},{"site":"ANIDB","externalId":16389},{"site":"KITSU","externalId":44773},{"site":"ANN","externalId":24466},{"site":"ANIME_PLANET","externalId":17336},{"site":"X","externalId":null},{"site":"OFFICIAL_SITE","externalId":null},{"site":"NETFLIX","externalId":81499847}]},"images":{"nodes":[{"id":9656,"facet":"LARGE_COVER","path":"anime/large-cover/lQoy0pN4GhAL3mY2bum29q2krOsmqFNZEzZBExYE.jpg"},{"id":9657,"facet":"SMALL_COVER","path":"anime/small-cover/FTYwxsBUzpXrX65CG5uQ6VceYnu0du0HY57CUVml.avif"}]},"studios":{"nodes":[{"id":338,"name":"AtelierPontdarc","slug":"atelierpontdarc"}]},"series":{"nodes":[]},"animethemes":[{"id":11618,"slug":"OP1","type":"OP","sequence":null,"song":{"id":11618,"title":"story","titleNative":null},"animethemeentries":[{"id":13515,"version":1,"episodes":"1-7, 9-13","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":15755,"basename":"IsekaiOjisan-OP1.webm","filename":"IsekaiOjisan-OP1","link":"https://v.animethemes.moe/IsekaiOjisan-OP1.webm","mimetype":"video/webm","size":40626930,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags":"","audio":{"id":12150,"basename":"IsekaiOji