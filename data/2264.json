{"id":2264,"name":"Planet With","slug":"planet_with","synopsis":"Souya Kuroi has dreams of people with superpowers fighting a massive dragon in the sky, but his real life is almost as weird. He's had amnesia for about two weeks and been taken in by a maid and an anthropomorphic cat. When a UFO in the shape of a stuffed bear approaches Sorimasaka City and other metros around the world, he's startled to see seven rainbow-sparkling heroes zoom out to confront it – just like in his dream. Even weirder, the maid wants him to leave his shelter to confront these heroes and take the source of their power.\n\n\n(Source: Anime News Network)","format":"TV","season":"SUMMER","year":2018,"createdAt":"2021-03-27 00:44:25","updatedAt":"2021-03-28 06:30:13","resources":{"nodes":[{"site":"MAL","externalId":37578},{"site":"ANILIST","externalId":101368},{"site":"KITSU","externalId":41093},{"site":"ANIDB","externalId":13965},{"site":"ANN","externalId":20801},{"site":"ANIME_PLANET","externalId":9871},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":4519,"facet":"LARGE_COVER","path":"anime/large-cover/jkqDKXFgO9hizyb5L7I3pBYpJlOtUcZTA1PHwaoQ.jpg"},{"id":4520,"facet":"SMALL_COVER","path":"anime/small-cover/P4mYfpSzutnqV9NTfz7sTaxMYRIv0uUUdv8GxBnt.avif"}]},"studios":{"nodes":[{"id":34,"name":"J.C.Staff","slug":"jcstaff"}]},"series":{"nodes":[]},"animethemes":[{"id":8251,"slug":"OP1","type":"OP","sequence":null,"song":{"id":8252,"title":"One Unit","titleNative":null},"animethemeentries":[{"id":9644,"version":1,"episodes":"1-5","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":9647,"basename":"PlanetWith-OP1-NCBD1080.webm","filename":"PlanetWith-OP1-NCBD1080","link":"https://v.animethemes.moe/PlanetWith-OP1-NCBD1080.webm","mimetype":"video/webm","size":44135016,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":7673,"basename":