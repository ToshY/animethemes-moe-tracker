{"id":4601,"title":{"romaji":"Kizetsu Yuusha to Ansatsu Hime","english":"The Shy Hero and the Assassin Princesses","native":"気絶勇者と暗殺姫"},"slug":"kizetsu_yuusha_to_ansatsu_hime","synopsis":"Hero Toto possesses great skills, but his extreme shyness has left him unable to form a party, causing him to remain stuck in the town where his journey began.\n\nOne day, he is suddenly invited to join a party by three beautiful women—Ciel, Anemone, and Goa. Overjoyed at finally setting off on an adventure, Toto is filled with excitement... but little does he know, these women are dead set on killing him!\n\nA deathly harem romcom unfolds as the socially anxious hero, who faints from mere flustered excitement around women, finds himself the target of three deadly companions, each with their own reasons for wanting him gone!","format":"TV","season":"SUMMER","year":2025,"createdAt":"2025-07-06 22:59:19","updatedAt":"2026-05-11 19:49:58","resources":{"nodes":[{"site":"ANIDB","externalId":19143},{"site":"ANILIST","externalId":186561},{"site":"ANIME_PLANET","externalId":null},{"site":"ANN","externalId":34610},{"site":"KITSU","externalId":49899},{"site":"LIVECHART","externalId":13034},{"site":"MAL","externalId":60951},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":12768,"facet":"SMALL_COVER","path":"anime/small-cover/s2BQrWO8yVYgUQlc59QlzhYVcQc4xtHu2Ud50qtX.avif"},{"id":12769,"facet":"LARGE_COVER","path":"anime/large-cover/GGqSoGqXlQrv6xWy5GGGL4JSKWRfPDuMGEriz6t2.jpg"}]},"studios":{"nodes":[{"id":121,"name":"Connect","slug":"connect"}]},"series":{"nodes":[]},"animethemes":[{"id":13771,"slug":"ED1","type":"ED","sequence":null,"song":{"id":13686,"title":{"romaji":"Sukima Jikan","native":null}},"animethemeentries":[{"id":16162,"version":1,"episodes":"1-","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":19041,"basename":"KizetsuYuusha-ED1.webm","filename":"KizetsuYuusha-ED1","link":"https://v