{"id":3822,"title":{"romaji":"Lycoris Recoil","english":null,"native":null},"slug":"lycoris_recoil","synopsis":"“LycoReco” is a café with a traditional Japanese twist located in downtown Tokyo. But the delicious coffee and sugary sweets are not the only orders this café takes! From delivering packages short distances, to pick-ups and drop-offs on the lonely streets at night, to zombies and giant monster extermination…?! Whatever your problem, we're here to help! We will solve any kind of \"trouble\" you may have!\n\r\n\n\r\nWaiting for you are the ever-smiling poster-girl and the cool, serious newcomer. A petite girl who never wants to work and a young woman approaching thirty who wants to get married. And the manager is a nice guy who’s obsessed with Japan!\n\r\n\n\r\nWhatever your order is, leave it all up to us♪","format":"TV","season":"SUMMER","year":2022,"createdAt":"2022-06-29 21:07:00","updatedAt":"2022-06-29 21:07:00","resources":{"nodes":[{"site":"MAL","externalId":50709},{"site":"ANILIST","externalId":143270},{"site":"ANIDB","externalId":17097},{"site":"KITSU","externalId":45705},{"site":"ANN","externalId":25104},{"site":"ANIME_PLANET","externalId":19027},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null},{"site":"NETFLIX","externalId":81620000}]},"images":{"nodes":[{"id":9586,"facet":"LARGE_COVER","path":"anime/large-cover/T1lOnKDgl4yWpgshTXWoxSxugkJkbqNpJCcTenno.jpg"},{"id":9587,"facet":"SMALL_COVER","path":"anime/small-cover/y6IFPZp4UL17cV4j12OOwDVYhijkB0oOKjjqVB0g.avif"}]},"studios":{"nodes":[{"id":8,"name":"A-1 Pictures","slug":"a_1_pictures"}]},"series":{"nodes":[{"id":632,"name":"Lycoris Recoil","slug":"lycoris_recoil"}]},"animethemes":[{"id":11592,"slug":"ED1","type":"ED","sequence":null,"song":{"id":11592,"title":{"romaji":"Hana no Tou","native":null}},"animethemeentries":[{"id":13487,"version":1,"episodes":"1-13","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":15717,"basename":