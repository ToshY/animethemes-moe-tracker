{"id":1813,"name":"Major 2nd","slug":"major_2nd","synopsis":"Shigeno Daigo is an elementary student whose father, Goro, is a professional baseball player. Inspired by his father, who was once a Major League player, Daigo started playing baseball with the Mifune Dolphins, a youth team. However, he was unable to live up to the expectations of being the son of a professional, and quit baseball after less than a year. Then, in the spring of his sixth-grade year, Daigo's school welcomes a transfer student, Sato Hikaru, whose father is Sato Toshiya, a former Major League player and Goro's close friend. The fate of these two young men begins to move forward!\n\n(Source: Crunchyroll)","format":"TV","season":"SPRING","year":2018,"createdAt":"2021-03-27 00:44:13","updatedAt":"2021-03-28 05:08:19","resources":{"nodes":[{"site":"MAL","externalId":36565},{"site":"ANILIST","externalId":100306},{"site":"KITSU","externalId":13952},{"site":"ANIDB","externalId":13518},{"site":"ANN","externalId":20204},{"site":"ANIME_PLANET","externalId":9243},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":3617,"facet":"LARGE_COVER","path":"anime/large-cover/zlVUiPnq9b7xlgg5snxurQbqUgIZtYvyMh8H4ikC.jpg"},{"id":3618,"facet":"SMALL_COVER","path":"anime/small-cover/YmWM1Xvb7gz6NIytDaGVia3vBYIvucnBCKqS7awE.avif"}]},"studios":{"nodes":[{"id":5,"name":"OLM","slug":"olm"}]},"series":{"nodes":[{"id":108,"name":"Major","slug":"major"}]},"animethemes":[{"id":8467,"slug":"OP1","type":"OP","sequence":1,"song":{"id":8468,"title":"Koete Ike","titleNative":null},"animethemeentries":[{"id":9895,"version":1,"episodes":"1-13","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":9338,"basename":"Major2nd-OP1.webm","filename":"Major2nd-OP1","link":"https://v.animethemes.moe/Major2nd-OP1.webm","mimetype":"video/webm","size":24426047,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags"