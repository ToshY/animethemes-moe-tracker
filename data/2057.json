{"id":2057,"name":"New Dominion Tank Police","slug":"new_dominion_tank_police","synopsis":"In the follow up to Shirows classic anime, Al, Leona and their trusty steed, Bonaparte, continue to fight crime in New Port City, alongside the rest of the Tank Police. But a new threat appears in the form of a series of terrorist attacks, using the latest weapons technology. The Tank Police are out-numbered and out-gunned, but Al and Leona set out to discover who or what is behind these attacks. With massive explosions and high-speed chases, Leona often causes more damage than the criminals she pursues.\n\n(Source: Anime News Network)","format":"OVA","season":"FALL","year":1993,"createdAt":"2021-03-27 00:44:20","updatedAt":"2021-03-28 05:51:52","resources":{"nodes":[{"site":"MAL","externalId":1152},{"site":"ANILIST","externalId":1152},{"site":"KITSU","externalId":1033},{"site":"ANIDB","externalId":897},{"site":"ANN","externalId":702},{"site":"ANIME_PLANET","externalId":2164},{"site":"HULU","externalId":null},{"site":"HIDIVE","externalId":null}]},"images":{"nodes":[{"id":4105,"facet":"LARGE_COVER","path":"anime/large-cover/TFU1jfQyLmtogGR1yL5eapZJBd8NqrKCKknxLUPr.png"},{"id":4106,"facet":"SMALL_COVER","path":"anime/small-cover/spYAiQB4JdZdnJObkktsvLBcB6VmQHP5PyN7qSpE.avif"}]},"studios":{"nodes":[{"id":34,"name":"J.C.Staff","slug":"jcstaff"}]},"series":{"nodes":[{"id":648,"name":"Dominion","slug":"dominion"}]},"animethemes":[{"id":937,"slug":"OP1","type":"OP","sequence":null,"song":{"id":937,"title":"JUST. Toki wo Koete","titleNative":null},"animethemeentries":[{"id":1045,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":13319,"basename":"NewDominionTankPolice-OP1.webm","filename":"NewDominionTankPolice-OP1","link":"https://v.animethemes.moe/NewDominionTankPolice-OP1.webm","mimetype":"video/webm","size":33300061,"resolution":480,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"DVD","tags":"DVD480","audio":{"id":11227,"basename"