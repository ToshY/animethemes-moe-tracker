{"id":434,"name":"Chibi Maruko-chan","slug":"chibi_maruko_chan","synopsis":"Momoko Sakura is an elementary school student who likes popular idol Momoe Yamaguchi and mangas. She is often called \"Chibi Maruko-chan\" due to her young age and small size. She lives together with her parents, her grandparents and her elder sister in a little town. In school, she has many friends with whom she studies and plays together everyday, including her close pal, Tama-chan; the student committee members, Maruo-kun and Migiwa-san; and the B-class trio: 'little master' Hanawa-kun, Hamaji-Bu Taro and Sekiguchi-kun. This is a fun-loving and enjoyable anime that portrays the simple things in life.\n\n\n(Source: Anime News Network)","format":"TV","season":"WINTER","year":1990,"createdAt":"2021-03-27 00:43:36","updatedAt":"2021-03-28 00:57:37","resources":{"nodes":[{"site":"MAL","externalId":951},{"site":"ANILIST","externalId":951},{"site":"KITSU","externalId":843},{"site":"ANIDB","externalId":1841},{"site":"ANN","externalId":479},{"site":"ANIME_PLANET","externalId":3406}]},"images":{"nodes":[{"id":865,"facet":"LARGE_COVER","path":"anime/large-cover/arzZf0lh9QM1ngNYpmIjLjovXJpcdNzM2M7SI60r.jpg"},{"id":866,"facet":"SMALL_COVER","path":"anime/small-cover/SETk2WZzH61KqV3gFcUKPQHhQPict42PbJhV00rX.avif"}]},"studios":{"nodes":[{"id":45,"name":"Nippon Animation","slug":"nippon_animation"}]},"series":{"nodes":[]},"animethemes":[{"id":568,"slug":"OP1","type":"OP","sequence":null,"song":{"id":568,"title":"Yume Ippai","titleNative":null},"animethemeentries":[{"id":634,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":12896,"basename":"ChibiMarukoChan-OP1.webm","filename":"ChibiMarukoChan-OP1","link":"https://v.animethemes.moe/ChibiMarukoChan-OP1.webm","mimetype":"video/webm","size":40706352,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":10780,"basename":"ChibiMarukoChan-OP1.ogg","filename":"Chi