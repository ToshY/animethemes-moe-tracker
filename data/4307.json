{"id":4307,"name":"Yozakura-san Chi no Daisakusen","slug":"yozakura_san_chi_no_daisakusen","synopsis":"High school student Taiyou Asano has been socially inept ever since his family died in a car crash. The only person he can properly interact with is his childhood friend, Mutsumi Yozakura—the head of the world's strongest family of spies. Mutsumi's eldest brother, Kyouichirou Yozakura, has been overprotective of her ever since he once rendered her severely injured. His love for Mutsumi is lethal, and Taiyou is his next target. To survive, Taiyou must marry Mutsumi and become a member of the Yozakura family. Thrown headfirst into chaos, Taiyou begins his journey to become a powerful spy in order to protect his wife and uncover the dark secrets of his past and the Yozakura family.","format":"TV","season":"SPRING","year":2024,"createdAt":"2024-04-14 13:58:11","updatedAt":"2024-04-14 13:58:11","resources":{"nodes":[{"site":"MAL","externalId":53865},{"site":"ANILIST","externalId":158898},{"site":"ANIDB","externalId":17773},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"HULU","externalId":null},{"site":"DISNEY_PLUS","externalId":null},{"site":"ANIME_PLANET","externalId":22577},{"site":"ANN","externalId":26739},{"site":"KITSU","externalId":46869}]},"images":{"nodes":[{"id":11789,"facet":"LARGE_COVER","path":"anime/large-cover/zKRjsgpPO9ZdWHCRFx4HWB6mZEtX9MFMud1LsRQJ.png"},{"id":11790,"facet":"SMALL_COVER","path":"anime/small-cover/EWmYVmoykg4dfyoNGhYKL3nYgNiZ951b6oryfnj4.avif"}]},"studios":{"nodes":[{"id":59,"name":"SILVER LINK.","slug":"silver_link"}]},"series":{"nodes":[{"id":700,"name":"Yozakura-san Chi no Daisakusen","slug":"yozakurasan_chi_no_daisakusen"}]},"animethemes":[{"id":12888,"slug":"OP1","type":"OP","sequence":1,"song":{"id":12843,"title":"Unmei-chan","titleNative":null},"animethemeentries":[{"id":15076,"version":1,"episodes":"1-","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":17776,"basename":"YozakuraSanChiNoDaisa