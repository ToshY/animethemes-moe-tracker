{"id":1692,"name":"Long Riders!","slug":"long_riders","synopsis":"The manga follows Ami Kurata, a first year college student with no special qualities. One day she happens to notice someone riding a folding bike, immediately falls in love with it, and uses all her savings to buy one. She eventually gets introduced to the world of long-distance bicycling and road racer bikes, and she forms a cycling team called Fortuna with four other female college students from the same school. Their goal is to ride in a \"brevet\" or long-distance event called \"Fresh.\"\n\n(Source: Anime News Network)","format":"TV","season":"FALL","year":2016,"createdAt":"2021-03-27 00:44:09","updatedAt":"2021-03-28 04:45:19","resources":{"nodes":[{"site":"MAL","externalId":30652},{"site":"ANILIST","externalId":21171},{"site":"KITSU","externalId":10878},{"site":"ANIDB","externalId":11201},{"site":"ANN","externalId":16986},{"site":"ANIME_PLANET","externalId":7192},{"site":"X","externalId":null},{"site":"OFFICIAL_SITE","externalId":null},{"site":"HIDIVE","externalId":null}]},"images":{"nodes":[{"id":3375,"facet":"LARGE_COVER","path":"anime/large-cover/MvhpVOyGFLpx3pEZDaNHbQrUnFAzyQmKHYaXCsJN.jpg"},{"id":3376,"facet":"SMALL_COVER","path":"anime/small-cover/vPti4FgygJZ8OjJJMwxbfpr5gkDYN1TmeeKUr4ZZ.avif"}]},"studios":{"nodes":[{"id":42,"name":"Actas","slug":"actas"}]},"series":{"nodes":[]},"animethemes":[{"id":6669,"slug":"OP1","type":"OP","sequence":null,"song":{"id":6669,"title":"♡㎞/h","titleNative":null},"animethemeentries":[{"id":7760,"version":1,"episodes":"1-4","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":6725,"basename":"LongRiders-OP1.webm","filename":"LongRiders-OP1","link":"https://v.animethemes.moe/LongRiders-OP1.webm","mimetype":"video/webm","size":60420063,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":5830,"basename":"LongRiders-OP1.ogg","filename":"LongRiders-OP1","link":"https://a.animethemes.moe/LongRi