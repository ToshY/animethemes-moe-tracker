{"id":2014,"title":{"romaji":"Nanaka 6/17","english":null,"native":null},"slug":"nanaka_617","synopsis":"Seventeen-year-old Nanaka Kirisato is a high school student serious about her studies and goals in life. She frequently criticizes her best friend, Nenji Nagihara, for being a childish delinquent who spends his time fighting other boys. Then one day, after a heated argument with Nenji, she falls off a flight of stairs and suffers a brain injury, resulting in her mind reverting to that of a six-year-old. With this in mind, Nanaka's father and Nenji must keep her injury a secret as she struggles to live a normal life and grow up all over again.\n\n\n(Source: Anime News Network)","format":"TV","season":"WINTER","year":2003,"createdAt":"2021-03-27 00:44:19","updatedAt":"2021-03-28 05:44:34","resources":{"nodes":[{"site":"MAL","externalId":776},{"site":"ANILIST","externalId":776},{"site":"KITSU","externalId":694},{"site":"ANIDB","externalId":473},{"site":"ANN","externalId":2150},{"site":"ANIME_PLANET","externalId":1481},{"site":"HULU","externalId":null}]},"images":{"nodes":[{"id":4019,"facet":"LARGE_COVER","path":"anime/large-cover/mSSZzaZRXOnx5sV8cUs9q3KEY4Z6G3ziktA3EI4l.jpg"},{"id":4020,"facet":"SMALL_COVER","path":"anime/small-cover/SDw2O9EEEyvcm1UnCB0HmpnJ344FkYfpiVkOk3am.avif"}]},"studios":{"nodes":[{"id":34,"name":"J.C.Staff","slug":"jcstaff"}]},"series":{"nodes":[]},"animethemes":[{"id":1778,"slug":"OP1","type":"OP","sequence":null,"song":{"id":1778,"title":{"romaji":"Sunao na Mama","native":null}},"animethemeentries":[{"id":1960,"version":1,"episodes":"1-13","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":676,"basename":"Nanaka-OP1.webm","filename":"Nanaka-OP1","link":"https://v.animethemes.moe/Nanaka-OP1.webm","mimetype":"video/webm","size":29125261,"resolution":480,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"DVD","tags":"NCDVD480","audio":{"id":697,"basename":"Nanaka-OP1.ogg","filename":"Nanaka-OP1","link":"https://a.animethemes.