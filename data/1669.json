{"id":1669,"name":"Lance N' Masques","slug":"lance_n_masques","synopsis":"Yotaro Hanafusa is a descendent of the “Knights of the World.” With the Knight’s Code of Chivalry hammered into him since childhood, Yotaro cannot stop himself from saving damsels in distress. He wears a mask, and is known on the street as “Knight Lancer” but he has always kept his identity a secret. While on an outing, Yotaro saves a 6-year-old girl, Makio Kidoin, the only child of a powerful business tycoon. When Yotaro discovers that Makio leads a lonely life in a huge estate, he resolves to protect her. He and his friends disguise themselves as lodgers and move into her mansion.\n\n\n(Source: Anime News Network)","format":"TV","season":"FALL","year":2015,"createdAt":"2021-03-27 00:44:09","updatedAt":"2021-03-28 04:41:15","resources":{"nodes":[{"site":"MAL","externalId":24011},{"site":"ANILIST","externalId":20712},{"site":"KITSU","externalId":8666},{"site":"ANIDB","externalId":10622},{"site":"ANN","externalId":16827},{"site":"ANIME_PLANET","externalId":6363},{"site":"OFFICIAL_SITE","externalId":null},{"site":"CRUNCHYROLL","externalId":null},{"site":"X","externalId":null}]},"images":{"nodes":[{"id":3329,"facet":"LARGE_COVER","path":"anime/large-cover/GDMhDb4ktFJVDfa2nawKga8Ef9Gym60DlMNHE1vN.png"},{"id":3330,"facet":"SMALL_COVER","path":"anime/small-cover/pNvKajU6QZH5X0FnyGqWJRndRhd6WKQaHdtEG0tm.avif"}]},"studios":{"nodes":[{"id":16,"name":"Studio Gokumi","slug":"studio_gokumi"}]},"series":{"nodes":[]},"animethemes":[{"id":6073,"slug":"OP1","type":"OP","sequence":null,"song":{"id":6073,"title":"Light for Knight","titleNative":null},"animethemeentries":[{"id":7013,"version":1,"episodes":"1-12","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":5949,"basename":"LanceNMasques-OP1.webm","filename":"LanceNMasques-OP1","link":"https://v.animethemes.moe/LanceNMasques-OP1.webm","mimetype":"video/webm","size":54285962,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","sourc