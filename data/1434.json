{"id":1434,"name":"Kannagi","slug":"kannagi","synopsis":"Based on a shounen manga by Takenashi Eri, serialised in Comic REX.\n\nOur unlucky protagonist, Jin, uses the trunk of a sacred tree to carve a statue for a school project. When he takes it outside, to his surprise it begins absorbing the surrounding earth and transforms into, hold your breath on this one, a girl! So like all similar setups this guardian deity is pretty pissed that her tree was cut down and lives with Jin while she takes out her anger on squashing bugs....er, cleaning the \"Impurities\". ","format":"TV","season":"FALL","year":2008,"createdAt":"2021-03-27 00:44:02","updatedAt":"2021-03-28 03:58:11","resources":{"nodes":[{"site":"MAL","externalId":3958},{"site":"ANILIST","externalId":3958},{"site":"KITSU","externalId":3378},{"site":"ANIDB","externalId":5720},{"site":"ANN","externalId":9295},{"site":"ANIME_PLANET","externalId":2132},{"site":"OFFICIAL_SITE","externalId":null}]},"images":{"nodes":[{"id":2859,"facet":"LARGE_COVER","path":"anime/large-cover/OUB387Wb9AfTNE7X6EYaROy60edbBkMakkiW5eNE.jpg"},{"id":2860,"facet":"SMALL_COVER","path":"anime/small-cover/QaWWMXHLkdmKXgCDRWhziBDpwAJmM4CPlJUyX1aF.avif"}]},"studios":{"nodes":[{"id":8,"name":"A-1 Pictures","slug":"a_1_pictures"},{"id":106,"name":"Ordet","slug":"ordet"}]},"series":{"nodes":[]},"animethemes":[{"id":2985,"slug":"OP1","type":"OP","sequence":null,"song":{"id":2985,"title":"motto☆Hade ni ne!","titleNative":null},"animethemeentries":[{"id":3358,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":2136,"basename":"Kannagi-OP1.webm","filename":"Kannagi-OP1","link":"https://v.animethemes.moe/Kannagi-OP1.webm","mimetype":"video/webm","size":39919333,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":2012,"basename":"Kannagi-OP1.ogg","filename":"Kannagi-OP1","link":"https://a.animethemes.moe/Kannagi-OP1.ogg","mimetype":"audio/ogg","size":3670375