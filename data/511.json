{"id":511,"name":"Comet Lucifer","slug":"comet_lucifer","synopsis":"The story takes place on the planet Gift, where precious crystals called Giftjium are buried in the earth. A young man named Sōgo lives in Garden Indigo, a prosperous mining town. Sougo's hobby is to collect rare crystals. One day, he gets wrapped up in a riot caused by his classmates Kaon, Roman, and Otto, and he loses his way until he finds a lake deep under the ground's mining ruins. There, he meets a mysterious girl with blue hair and red eyes that gaze straight ahead. The story follows the adventure of what happens after this meeting.\n\n\n(Source: Anime News Network)","format":"TV","season":"FALL","year":2015,"createdAt":"2021-03-27 00:43:38","updatedAt":"2021-03-28 01:11:12","resources":{"nodes":[{"site":"MAL","externalId":31318},{"site":"ANILIST","externalId":21275},{"site":"KITSU","externalId":11234},{"site":"ANIDB","externalId":11453},{"site":"ANN","externalId":17386},{"site":"ANIME_PLANET","externalId":7350},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null}]},"images":{"nodes":[{"id":1019,"facet":"LARGE_COVER","path":"anime/large-cover/XgCy33yGIFfVCMcYWmtOl1kVNqYFdz4Qgue9fvYL.png"},{"id":1020,"facet":"SMALL_COVER","path":"anime/small-cover/20avPipWsjxKie5NGk0oYdOqKBea1cVvbarwmfdw.avif"}]},"studios":{"nodes":[{"id":24,"name":"8bit","slug":"8bit"}]},"series":{"nodes":[]},"animethemes":[{"id":6023,"slug":"OP1","type":"OP","sequence":null,"song":{"id":6023,"title":"The Seed and the Sower","titleNative":null},"animethemeentries":[{"id":6948,"version":1,"episodes":"1-11","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":5864,"basename":"CometLucifer-OP1.webm","filename":"CometLucifer-OP1","link":"https://v.animethemes.moe/CometLucifer-OP1.webm","mimetype":"video/webm","size":36185689,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":5194,"basename":"CometLucifer-OP1.ogg","filename":"CometLucifer-O