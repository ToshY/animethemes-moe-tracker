{"id":2347,"title":{"romaji":"Rail Wars!","english":null,"native":null},"slug":"rail_wars","synopsis":"The \"dream railway paradise entertainment\" story is set in a parallel world where Japan did not privatize its national railways. Naohito Takayama is an ordinary high school boy who dreams of a comfortable future working for the top-rated Japanese National Railways. He is assigned as a trainee in the Railways Security Force full of odd characters such as Sakurai, a troublemaker who hates men. On top of that, an extremist group called \"RJ\" plots to privatize the Japanese National Railways.\n\n(Source: Anime News Network)","format":"TV","season":"SUMMER","year":2014,"createdAt":"2021-03-27 00:44:27","updatedAt":"2021-03-28 07:01:18","resources":{"nodes":[{"site":"MAL","externalId":23309},{"site":"ANILIST","externalId":20583},{"site":"KITSU","externalId":8155},{"site":"ANIDB","externalId":10357},{"site":"ANN","externalId":16039},{"site":"ANIME_PLANET","externalId":6143},{"site":"X","externalId":null},{"site":"OFFICIAL_SITE","externalId":null}]},"images":{"nodes":[{"id":4685,"facet":"LARGE_COVER","path":"anime/large-cover/sRZ6T5Lk77J7VB3K6jVreWDduZAm9FwbA5IspiXS.jpg"},{"id":4686,"facet":"SMALL_COVER","path":"anime/small-cover/3YKxdR9VwDMe2Uzbehw0o8NqpjhD9aNdLhrmFAvT.avif"}]},"studios":{"nodes":[{"id":139,"name":"Passione","slug":"passione"}]},"series":{"nodes":[]},"animethemes":[{"id":5663,"slug":"OP1","type":"OP","sequence":null,"song":{"id":5663,"title":{"romaji":"Mukai Kaze ni Utarenagara","native":null}},"animethemeentries":[{"id":6498,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":5628,"basename":"RailWars-OP1.webm","filename":"RailWars-OP1","link":"https://v.animethemes.moe/RailWars-OP1.webm","mimetype":"video/webm","size":66230177,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":5002,"basename":"RailWars-OP1.ogg","filename":"RailWars-OP1","link":"https:/