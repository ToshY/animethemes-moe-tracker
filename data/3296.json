{"id":3296,"title":{"romaji":"Zettai Shounen","english":null,"native":null},"slug":"zettai_shounen","synopsis":"Aizawa Ayumu is a young boy, who is sent to a small town called Tana to live with his father for a while. Even though he doesn't want to go, he agrees to do so when his mother offers him a mountain bike. Ayumu used to live in Tana before, and now his memories of the time are shrouded in mystery - apparently something happened when he was a child. Enter Miku, a young girl who knows more than she tells, weird glowing lights floating around, reflections of UFOish objects in the eyes of cats and dogs, a nosy female announcer, a forest with a mysterious past, and a weird boy called Wakkun, who wears the clothes Ayumu used to when he was a child, and you get the world of Zettai Shonen, where mysteries remain mysteries amidst a slow, normal, everyday life.\n\n\n(Source: Anime News Network)","format":"TV","season":"SPRING","year":2005,"createdAt":"2021-03-27 00:44:52","updatedAt":"2021-03-28 09:53:49","resources":{"nodes":[{"site":"MAL","externalId":308},{"site":"ANILIST","externalId":308},{"site":"KITSU","externalId":279},{"site":"ANIDB","externalId":2837},{"site":"ANN","externalId":5093},{"site":"ANIME_PLANET","externalId":1062}]},"images":{"nodes":[{"id":6575,"facet":"LARGE_COVER","path":"anime/large-cover/jZZhYn8A0YH6jZKPjoLQttsqZq321K0nzjuoqUyE.jpg"},{"id":6576,"facet":"SMALL_COVER","path":"anime/small-cover/nZTm2s0J86d4g2wHfL1dk0jZM6UkWqxKUHWtAFdF.avif"}]},"studios":{"nodes":[{"id":114,"name":"Ajia-Do","slug":"ajia_do"}]},"series":{"nodes":[]},"animethemes":[{"id":2211,"slug":"OP1","type":"OP","sequence":null,"song":{"id":2211,"title":{"romaji":"Hikari no Silhouette","native":null}},"animethemeentries":[{"id":2492,"version":1,"episodes":"1-13","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":1156,"basename":"ZettaiShounen-OP1.webm","filename":"ZettaiShounen-OP1","link":"https://v.animethemes.moe/ZettaiShounen-OP1.webm","mimetype":"video/webm","size":302