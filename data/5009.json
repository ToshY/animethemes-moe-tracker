{"id":5009,"title":{"romaji":"Kyouran Reijou Nia Liston","english":"Nia Liston: The Merciless Maiden","native":"凶乱令嬢ニア・リストン"},"slug":"kyouran_reijou_nia_liston","synopsis":"A great hero lies undefeated on her deathbed, regretting that she never found a foe who could take her down. She never intended to meet her fate anywhere other than on the battlefield, and her peaceful demise has her wishing desperately that things could have been different... But when she suddenly comes to in the body of the young, frail Nia Liston, she’s got an all-new fight ahead of her. Nia is a sickly child, meaning she has a long way to go before she’s in fighting form. Now that she’s been given a second shot at life, however, she’s determined to get what she wants. She’s going to live—and die—for battle this time! Make way for the Merciless Maiden!\n\n(Source: J-Novel Club)","format":"TV","season":"FALL","year":2026,"createdAt":"2026-10-06 03:21:38","updatedAt":"2026-10-13 17:36:46","resources":{"nodes":[{"site":"ANILIST","externalId":206949},{"site":"ANIME_PLANET","externalId":27372},{"site":"ANIDB","externalId":19865},{"site":"LIVECHART","externalId":13504},{"site":"MAL","externalId":63382},{"site":"X","externalId":null},{"site":"OFFICIAL_SITE","externalId":null},{"site":"HIDIVE","externalId":null},{"site":"ANN","externalId":38387},{"site":"KITSU","externalId":50764}]},"images":{"nodes":[{"id":13867,"facet":"SMALL_COVER","path":"anime/small-cover/db0H7yAfGVtM1e9OHfLKzyVnKVIuq7JwJ2FsOGC9.avif"},{"id":13868,"facet":"LARGE_COVER","path":"anime/large-cover/LsZcKHXrgXEGreXUJJ3K5MU2G2philw3MVWYfSA1.png"}]},"studios":{"nodes":[{"id":486,"name":"Konami animation","slug":"konami_animation"}]},"series":{"nodes":[]},"animethemes":[{"id":14829,"slug":"OP1","type":"OP","sequence":1,"song":{"id":14719,"title":{"romaji":"RESPAWN!!","native":"リスポーン!!"}},"animethemeentries":[{"id":17333,"version":1,"episodes":"1-2","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":20102,"basename":"NiaListon-OP1.webm