{"id":112,"title":{"romaji":"Amagami SS: Tachibana Miya-hen - Imouto","english":"Amagami SS: Sister","native":"アマガミSS イモウト"},"slug":"amagami_ss_tachibana_miya_hen_imouto","synopsis":"In this fun, light-hearted Special episode, Miya Tachibana attempts to figure out why her weird and slightly perverted older brother (Junichi) has such a friendly relationship with many of the girls in his school, yet can't manage to find himself a girlfriend. Fearing he might become a bum later in life and lose his job, she decides to stalk him to find out if there's more to him than what she sees at home.\n\nThe episode is titled \"Imouto\" (Sister) and is available only on Blu-Ray in Volume 13 of the Amagami SS anime series.","format":"SPECIAL","season":"SPRING","year":2011,"createdAt":"2021-03-27 00:43:28","updatedAt":"2021-03-28 00:00:57","resources":{"nodes":[{"site":"MAL","externalId":9925},{"site":"ANILIST","externalId":9925},{"site":"KITSU","externalId":5943},{"site":"ANIDB","externalId":7506},{"site":"ANN","externalId":11474},{"site":"ANIME_PLANET","externalId":3615}]},"images":{"nodes":[{"id":223,"facet":"LARGE_COVER","path":"anime/large-cover/ixPPrgGclZlFYEH6ZogffhKLj9XGclrHChQR6TnJ.jpg"},{"id":224,"facet":"SMALL_COVER","path":"anime/small-cover/xTsr6WkJC2CfkV7Z3k1D01XjRpdVeJRiCpubf8dq.avif"}]},"studios":{"nodes":[{"id":20,"name":"AIC","slug":"aic"}]},"series":{"nodes":[{"id":4,"name":"Amagami SS","slug":"amagami_ss"}]},"animethemes":[{"id":4205,"slug":"OP1","type":"OP","sequence":null,"song":{"id":4205,"title":{"romaji":"Kimi no Mama de","native":null}},"animethemeentries":[{"id":4804,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":3491,"basename":"AmagamiImouto-OP1.webm","filename":"AmagamiImouto-OP1","link":"https://v.animethemes.moe/AmagamiImouto-OP1.webm","mimetype":"video/webm","size":47914636,"resolution":1080,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"BD","tags":"NCBD1080","audio":{"id":3210,"basename":"Amagam