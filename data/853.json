{"id":853,"name":"Garo: Guren no Tsuki","slug":"garo_guren_no_tsuki","synopsis":"In the capital city of an elegant, feudal society, a powerful spiritual barrier protects people from demonic monsters known as “horrors”—at least, those lucky enough to live in the northern part of the city. For the commoners who live to the south, it’s a completely different story. As soon as night falls, the horrors begin their dark hunt, feasting on the souls of any humans who cross their path. Against unbeatable odds, the fate of the city will fall to a small group of warriors dedicated to protecting the citizens and fighting through the night.\n\n(Source: Funimation)","format":"TV","season":"FALL","year":2015,"createdAt":"2021-03-27 00:43:46","updatedAt":"2021-03-28 02:12:34","resources":{"nodes":[{"site":"MAL","externalId":28537},{"site":"ANILIST","externalId":21277},{"site":"KITSU","externalId":10045},{"site":"ANIDB","externalId":11459},{"site":"ANN","externalId":17526},{"site":"ANIME_PLANET","externalId":6869},{"site":"OFFICIAL_SITE","externalId":null},{"site":"X","externalId":null},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":1701,"facet":"LARGE_COVER","path":"anime/large-cover/2tyZWjfMPglwGT2kUCQBx0aZkwhXjpmj1muYV3rt.png"},{"id":1702,"facet":"SMALL_COVER","path":"anime/small-cover/ATYuscIQ6UGhmntLOOT7Ha3xUjwQUi0wNgUMUjIF.avif"}]},"studios":{"nodes":[{"id":89,"name":"MAPPA","slug":"mappa"}]},"series":{"nodes":[{"id":51,"name":"Garo","slug":"garo"}]},"animethemes":[{"id":6039,"slug":"OP2","type":"OP","sequence":2,"song":{"id":6039,"title":"Tsukihana","titleNative":null},"animethemeentries":[{"id":6966,"version":1,"episodes":"14-23","nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":5889,"basename":"GaroGurenNoTsuki-OP2.webm","filename":"GaroGurenNoTsuki-OP2","link":"https://v.animethemes.moe/GaroGurenNoTsuki-OP2.webm","mimetype":"video/webm","size":26460869,"resolution":720,"nc":false,"subbed":false,"lyrics":false,"overlap":"NONE","source":"WEB","tags":