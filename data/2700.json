{"id":2700,"name":"So Ra No Wo To","slug":"so_ra_no_wo_to","synopsis":"In a lonely corner of the world, on the edge of No Man&rsquo;s Land, sits Clocktower Fortress. It&rsquo;s home to the 1121st Platoon of the Helvetian Army, and their newest member is a 15-year-old volunteer named Kanata Sorami, who enlisted to learn how to play the bugle. When she was a child, Kanata was saved by a beautiful soldier and found inspiration in the clear, golden sound of her trumpet. From that day forward, Kanata decided music would be her life. \n\nAs the other platoon members train her how to be a bugler and a soldier, Kanata's enduring optimism will inspire them to look for happiness and beauty, even in a world haunted by war.\n\n(Source: Right Stuf, Inc.)","format":"TV","season":"WINTER","year":2010,"createdAt":"2021-03-27 00:44:37","updatedAt":"2021-03-28 08:04:58","resources":{"nodes":[{"site":"MAL","externalId":6802},{"site":"ANILIST","externalId":6802},{"site":"KITSU","externalId":7668},{"site":"ANIDB","externalId":6783},{"site":"ANN","externalId":11023},{"site":"ANIME_PLANET","externalId":2753},{"site":"CRUNCHYROLL","externalId":null}]},"images":{"nodes":[{"id":5387,"facet":"LARGE_COVER","path":"anime/large-cover/cOzTMvrAoKJKybMsGpVa396a2OXI97kQHjVxI9yd.jpg"},{"id":5388,"facet":"SMALL_COVER","path":"anime/small-cover/83WIlaUJOhL8ttdUdGDIWgMD1qJUYGxGfCaIclG3.avif"}]},"studios":{"nodes":[{"id":8,"name":"A-1 Pictures","slug":"a_1_pictures"}]},"series":{"nodes":[]},"animethemes":[{"id":3956,"slug":"OP1","type":"OP","sequence":null,"song":{"id":3956,"title":"Hikari no Senritsu","titleNative":null},"animethemeentries":[{"id":4499,"version":1,"episodes":null,"nsfw":false,"spoiler":false,"videos":{"nodes":[{"id":3301,"basename":"SoRaNoWoTo-OP1.webm","filename":"SoRaNoWoTo-OP1","link":"https://v.animethemes.moe/SoRaNoWoTo-OP1.webm","mimetype":"video/webm","size":17189320,"resolution":576,"nc":true,"subbed":false,"lyrics":false,"overlap":"NONE","source":"DVD","tags":"NCDVD576","audio"